<?xml version="1.0" encoding="utf-8"?>
<!-- Contour des champs Hesba.Field : turquoise au focus, gris clair sinon -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/hesba_accent" android:state_focused="true" />
    <item android:alpha="0.5" android:color="@color/hesba_border" android:state_enabled="false" />
    <item android:color="@color/hesba_text_secondary" android:state_hovered="true" />
    <item android:color="@color/hesba_border" />
</selector>
