<?xml version="1.0" encoding="utf-8"?>
<!-- Option à choisir (langue) : filet fin ; choisie → filet safran épais et fond safran très doux -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/hb_accent_soft" />
            <stroke android:width="2dp" android:color="@color/hb_accent" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/hb_surface" />
            <stroke android:width="1dp" android:color="@color/hb_line" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
</selector>
