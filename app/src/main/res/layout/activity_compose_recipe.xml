<?xml version="1.0" encoding="utf-8"?>
<!-- Même ordre que activity_nouvelle_recette (Aya) : retour + titre, photo, nom, parts, marge, ingrédients, bouton.
     Avec en plus la carte des résultats (coût du lot, coût par part, prix conseillé). Couleurs : palette Hesba. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:orientation="vertical">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

      <!-- 1. Retour + titre -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back"
            android:clickable="true"
            android:contentDescription="Retour"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/brun"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

          <TextView
              android:id="@+id/txtRecipeName"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="serif"
              android:text="Nouvelle recette"
              android:textColor="@color/brun"
              android:textSize="24sp"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/txtComposeSubtitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Composer la recette"
              android:textColor="@color/brun_clair"
              android:textSize="14sp" />
        </LinearLayout>
      </LinearLayout>

      <!-- 2. Photo facultative : appui = choisir une image dans la galerie -->
      <FrameLayout
          android:id="@+id/photoZone"
          android:layout_width="match_parent"
          android:layout_height="160dp"
          android:layout_marginTop="18dp"
          android:background="@drawable/bg_dashed"
          android:clickable="true"
          android:contentDescription="Ajouter une photo"
          android:focusable="true">

        <ImageView
            android:id="@+id/imgRecipePhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/photoPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

          <ImageView
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:importantForAccessibility="no"
              android:src="@android:drawable/ic_menu_camera"
              app:tint="@color/brun_clair" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Ajouter une photo"
              android:textColor="@color/brun"
              android:textSize="14sp"
              android:textStyle="bold" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:background="@drawable/bg_chip"
              android:paddingStart="10dp"
              android:paddingTop="2dp"
              android:paddingEnd="10dp"
              android:paddingBottom="2dp"
              android:text="Facultatif"
              android:textColor="@color/brun_clair"
              android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Changer la photo"
            android:textColor="@color/brun"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
      </FrameLayout>

      <!-- 3. Nom de la recette -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="18dp"
          android:text="Nom de la recette"
          android:textColor="@color/brun"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editRecipeName"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/bg_input"
          android:hint="Nom de ta recette"
          android:inputType="textCapSentences"
          android:maxLines="1"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />

      <!-- 4. Nombre de parts -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="Nombre de parts"
          android:textColor="@color/brun"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editYield"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/bg_input"
          android:hint="Combien de parts obtiens-tu ?"
          android:inputType="number"
          android:maxLines="1"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="Temps de préparation (minutes)"
          android:textColor="@color/brun"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editPrepTime"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/bg_input"
          android:hint="Ex: 30 (30 min par défaut)"
          android:inputType="number"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />
      <!-- 5. Marge souhaitée (%) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="Marge souhaitée (%)"
          android:textColor="@color/brun"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editMargin"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/bg_input"
          android:hint="Ex: 40"
          android:inputType="numberDecimal"
          android:maxLines="1"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:text="40"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />

      <!-- 6. Ingrédients choisis + quantité -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="18dp"
          android:background="@drawable/bg_card"
          android:orientation="vertical"
          android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingrédients"
            android:textColor="@color/brun"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNoIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Aucun ingrédient ajouté. Appuie sur « + Ajouter un ingrédient »."
            android:textColor="@color/brun_clair"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/listLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnAddIngredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="+ Ajouter un ingrédient"
            android:textColor="@color/safran_texte"
            android:textSize="15sp"
            android:textStyle="bold" />
      </LinearLayout>

      <!-- Résultats calculés en direct -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:background="@drawable/bg_card_dark"
          android:orientation="vertical"
          android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Coût du lot"
              android:textColor="@color/caramel"
              android:textSize="14sp" />

          <TextView
              android:id="@+id/txtBatchCost"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0,00 dt"
              android:textColor="@color/creme"
              android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPieceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Coût par part"
            android:textColor="@color/caramel"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCostPerPiece"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="0,00 dt"
            android:textColor="@color/creme"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAdvisedPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prix conseillé : 0,00 dt"
            android:textColor="@color/jaune_energie"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMostExpensive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ingrédient le plus cher : —"
            android:textColor="@color/caramel"
            android:textSize="14sp" />
      </LinearLayout>

      <!-- 7. Bouton principal -->
      <Button
          android:id="@+id/btnSaveRecipe"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="18dp"
          android:backgroundTint="@color/safran"
          android:text="Enregistrer la recette"
          android:textAllCaps="false"
          android:textColor="@color/brun"
          android:textSize="16sp"
          android:textStyle="bold"
          app:cornerRadius="16dp" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>