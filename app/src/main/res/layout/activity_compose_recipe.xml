<?xml version="1.0" encoding="utf-8"?>
<!-- Nouvelle recette / Composer la recette (design Minimal) :
     barre ardoise avec retour ; cartes « La recette », « Ingrédients », « Coûts cachés », « Marge et prix » ;
     résumé collé en bas (coût par part, badge de marge) avec le seul bouton principal « Enregistrer ». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== Carte 1 : la recette ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Photo facultative -->
                    <FrameLayout
                        android:id="@+id/photoZone"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_photo"
                        android:clickable="true"
                        android:contentDescription="@string/cd_choose_photo"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/imgPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtPhotoHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="@dimen/space_s"
                            android:gravity="center"
                            android:text="@string/compose_photo_hint"
                            android:textAppearance="@style/Hesba.Text.Caption"
                            app:drawableTint="@color/hesba_text_hint"
                            app:drawableTopCompat="@drawable/ic_photo_add" />

                        <TextView
                            android:id="@+id/txtPhotoChange"
                            style="@style/Hesba.Tag"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="@dimen/space_s"
                            android:text="@string/compose_photo_change"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:hint="@string/field_recipe_name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editName"
                            style="@style/Widget.Hesba.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPortions"
                            style="@style/Hesba.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            android:hint="@string/field_portions"
                            app:helperText="@string/helper_portions">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editPortions"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:inputType="number"
                                android:maxLength="5" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrep"
                            style="@style/Hesba.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:hint="@string/field_prep_time"
                            app:helperText="@string/helper_optional"
                            app:suffixText="@string/unit_minutes">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editPrep"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:inputType="number"
                                android:maxLength="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Carte 2 : ingrédients ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/section_ingredients"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/compose_lines_note"
                        android:textAppearance="@style/Hesba.Text.Caption" />

                    <LinearLayout
                        android:id="@+id/listLines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/txtLinesError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/Hesba.Text.Caption"
                        android:textColor="@color/hesba_error"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddLine"
                        style="@style/Hesba.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/action_add_ingredient_line"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Carte 3 : coûts cachés ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/section_hidden_costs"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/compose_hidden_note"
                        android:textAppearance="@style/Hesba.Text.Caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPackaging"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/field_packaging"
                        app:helperText="@string/helper_packaging"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPackaging"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEnergy"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/field_energy"
                        app:helperText="@string/helper_energy"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editEnergy"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLabor"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/field_labor"
                        app:helperText="@string/helper_labor"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editLabor"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLaborEstimate"
                        style="@style/Hesba.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtFixedNote"
                        style="@style/Hesba.Note"
                        android:layout_marginTop="@dimen/space_m"
                        android:textAppearance="@style/Hesba.Text.Caption"
                        android:textColor="@color/hesba_text_primary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Carte 4 : marge et prix ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/section_margin_price"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilMargin"
                            style="@style/Hesba.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="2"
                            android:hint="@string/field_target_margin"
                            app:suffixText="@string/percent_sign">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editMargin"
                                style="@style/Widget.Hesba.EditText.Money"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLength="5" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrice"
                            style="@style/Hesba.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="3"
                            android:hint="@string/field_selling_price"
                            app:suffixText="@string/currency_short">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editPrice"
                                style="@style/Widget.Hesba.EditText.Money"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtPriceHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/Hesba.Text.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseSuggested"
                        style="@style/Hesba.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Résumé collé en bas : les chiffres restent visibles pendant la saisie ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_bar"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cost_per_portion"
                    android:textAppearance="@style/Hesba.Text.Caption" />

                <TextView
                    android:id="@+id/txtPerPortion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Hesba.Text.Amount"
                    tools:text="0,878 DT" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_batch_cost"
                    android:textAppearance="@style/Hesba.Text.Caption" />

                <TextView
                    android:id="@+id/txtBatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hesba.Money"
                    tools:text="35,120 DT" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSummaryBadge"
                style="@style/Hesba.Badge.Success"
                android:layout_marginEnd="@dimen/space_s"
                android:visibility="gone"
                tools:text="Marge OK · 55 %"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txtSummaryLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/Hesba.Text.Caption"
                tools:text="Vendue 1,950 DT" />
        </LinearLayout>

        <!-- seul bouton principal de l'écran -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/action_save_recipe" />
    </LinearLayout>
</LinearLayout>
