<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <TextView android:id="@+id/txtActivityProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon atelier · à domicile" android:textColor="@color/brun_clair" android:textSize="15sp"/>
      <TextView android:id="@+id/txtMonthTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bilan d'octobre" android:textColor="@color/brun" android:textSize="32sp" android:textStyle="bold" android:fontFamily="serif"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_dark" android:padding="22dp" android:layout_marginTop="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bénéfice du mois" android:textColor="@color/caramel" android:textSize="15sp"/>
        <TextView android:id="@+id/txtProfit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="1 370 dt" android:textColor="@color/creme" android:textSize="44sp" android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:id="@+id/txtMargin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="▲ Marge de 32 %" android:textColor="@color/vert_pale" android:textSize="16sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:weightSum="2">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_box_dark" android:padding="14dp" android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ventes" android:textColor="@color/caramel" android:textSize="14sp"/>
            <TextView android:id="@+id/txtSales" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 280 dt" android:textColor="@color/creme" android:textSize="18sp" android:textStyle="bold"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_box_dark" android:padding="14dp" android:layout_marginStart="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coûts" android:textColor="@color/caramel" android:textSize="14sp"/>
            <TextView android:id="@+id/txtCosts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 910 dt" android:textColor="@color/creme" android:textSize="18sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ventes par semaine" android:textColor="@color/brun" android:textSize="18sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="160dp" android:orientation="horizontal" android:weightSum="4" android:layout_marginTop="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="900" android:textColor="@color/brun" android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="56dp" android:layout_height="90dp" android:background="@drawable/bg_bar"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="S1" android:textColor="@color/brun_clair" android:textSize="14sp"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="1 200" android:textColor="@color/brun" android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="56dp" android:layout_height="120dp" android:background="@drawable/bg_bar"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="S2" android:textColor="@color/brun_clair" android:textSize="14sp"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="1 050" android:textColor="@color/brun" android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="56dp" android:layout_height="105dp" android:background="@drawable/bg_bar"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="S3" android:textColor="@color/brun_clair" android:textSize="14sp"/>
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="1 130" android:textColor="@color/brun" android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="56dp" android:layout_height="113dp" android:background="@drawable/bg_bar"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="S4" android:textColor="@color/brun_clair" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_alert" android:padding="18dp" android:layout_marginTop="14dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="⚠️" android:textColor="@color/brun" android:textSize="24sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
          <TextView android:id="@+id/txtAlertTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Le prix du beurre a changé" android:textColor="@color/brun" android:textSize="17sp" android:textStyle="bold"/>
          <TextView android:id="@+id/txtAlertSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 recettes sont à vérifier" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Seuil de rentabilité" android:textColor="@color/brun" android:textSize="16sp" android:textStyle="bold"/>
          <TextView android:id="@+id/txtBreakEvenStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atteint ✓" android:textColor="@color/vert" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/progressBreakEven" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="12dp" android:max="100" android:progress="100" android:progressTint="@color/vert" android:progressBackgroundTint="@color/caramel"/>
        <TextView android:id="@+id/txtBreakEvenInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tes coûts fixes sont payés depuis le 12 du mois" android:textColor="@color/brun_clair" android:textSize="14sp"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/white" android:elevation="8dp">
    <LinearLayout android:id="@+id/navBilan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_nav_active">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_bilan" android:contentDescription="Bilan" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Bilan" android:textColor="@color/brun" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navRecettes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_recettes" android:contentDescription="Recettes" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Recettes" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navIngredients" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_ingredients" android:contentDescription="Ingrédients" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Ingrédients" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navVentes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_ventes" android:contentDescription="Ventes" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Ventes" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
