<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil en grille Bento : des cartes arrondies de tailles différentes, une idée par carte.
     Rangée = 78 dp, carte haute = 166 dp, espace 10 dp (dimens_bento.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hb_bento_bg"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/sp_4"
            android:paddingTop="@dimen/sp_5"
            android:paddingEnd="@dimen/sp_4"
            android:paddingBottom="@dimen/sp_5">

            <!-- En-tête : date · commerce, salutation selon l'heure, profil -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHeader"
                        style="@style/Hesba.Bento.Label"
                        android:layout_width="match_parent"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/hb_bento_ink_soft" />

                    <TextView
                        android:id="@+id/txtGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_1"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:fontFamily="@font/hb_sans_semibold"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/hb_bento_ink"
                        android:textSize="26sp"
                        tools:text="Bonsoir, Eya" />
                </LinearLayout>

                <!-- profil : initiale du prénom ou du commerce, sinon l'icône -->
                <FrameLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="@dimen/touch"
                    android:layout_height="@dimen/touch"
                    android:layout_marginStart="@dimen/sp_3"
                    android:background="@drawable/bg_bento_avatar"
                    android:clickable="true"
                    android:contentDescription="@string/tab_profile"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/hb_sans_semibold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/hb_bento_avatar_ink"
                        android:textSize="17sp"
                        tools:text="E" />

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_profile"
                        android:visibility="gone"
                        app:tint="@color/hb_bento_avatar_ink" />
                </FrameLayout>
            </LinearLayout>

            <!-- Grille Bento, toujours affichée (sans données, la carte « À faire maintenant » guide
                 le premier usage) ; cachée jusqu'aux premières données pour ne pas clignoter -->
            <LinearLayout
                android:id="@+id/bento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1 · Marge moyenne (toute la largeur, 2 rangées) -->
                <LinearLayout
                    android:id="@+id/cardMargin"
                    style="@style/Hesba.Bento.Card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_weight="0"
                    android:background="@drawable/bg_bento_hero"
                    android:elevation="0dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Hesba.Bento.Label"
                            android:text="@string/bento_margin_label" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtMargin"
                            style="@style/Hesba.Bento.Big"
                            tools:text="44,3 %" />

                        <TextView
                            android:id="@+id/txtMarginSub"
                            style="@style/Hesba.Bento.Sub"
                            android:layout_marginTop="@dimen/sp_1"
                            android:textColor="@color/hb_bento_hero_soft"
                            tools:text="objectif moyen 60 % · 4 recettes" />
                    </LinearLayout>

                    <com.example.hesba.ui.widget.MarginRingView
                        android:id="@+id/ringMargin"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="@dimen/sp_3" />
                </LinearLayout>

                <!-- rangées 3-4 : scanner (haut) | à corriger + prix -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardScan"
                        style="@style/Hesba.Bento.Card"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_bento_scan"
                        android:elevation="0dp"
                        android:orientation="vertical"
                        android:padding="@dimen/bento_pad">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_bento_chip">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_scan"
                                app:tint="@color/hb_bento_scan_icon" />
                        </FrameLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Hesba.Bento.Title"
                            android:text="@string/action_scan_invoice" />

                        <TextView
                            style="@style/Hesba.Bento.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/bento_scan_sub"
                            android:textColor="@color/hb_bento_scan_soft" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/bento_gap"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardFix"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:background="@drawable/bg_bento_bad"
                            android:elevation="0dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtFixCount"
                                    style="@style/Hesba.Bento.Big"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    android:textSize="26sp"
                                    tools:text="4" />

                                <TextView
                                    android:id="@+id/txtFixLabel"
                                    style="@style/Hesba.Bento.Sub"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    tools:text="à corriger" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/imgFix"
                                style="@style/Hesba.Bento.Icon"
                                android:src="@drawable/ic_alert"
                                app:tint="@color/hb_bento_bad_icon" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bento_gap" />

                        <LinearLayout
                            android:id="@+id/cardPrice"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtPriceName"
                                    style="@style/Hesba.Bento.Name"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    tools:text="Beurre" />

                                <TextView
                                    android:id="@+id/txtPriceDelta"
                                    style="@style/Hesba.Bento.Mono"
                                    android:layout_marginStart="@dimen/sp_2"
                                    android:fontFamily="@font/hb_mono_medium"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    tools:text="+12,8 %" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtPriceFrom"
                                style="@style/Hesba.Bento.Mono"
                                android:layout_width="match_parent"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAlignment="viewStart"
                                tools:text="3,900 → 4,400 DT" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- rangées 5-6 : une action à faire maintenant -->
                <LinearLayout
                    android:id="@+id/cardTodo"
                    style="@style/Hesba.Bento.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:layout_weight="0"
                    android:minHeight="@dimen/bento_tall"
                    android:orientation="vertical"
                    android:padding="@dimen/bento_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hesba.Bento.Label"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/bento_todo_label" />

                        <TextView
                            android:id="@+id/btnNextAlert"
                            style="@style/Hesba.Bento.Mono"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="@dimen/touch"
                            android:paddingStart="@dimen/sp_2"
                            android:paddingEnd="@dimen/sp_2"
                            tools:text="1 / 4  ›" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTodoTitle"
                        style="@style/Hesba.Bento.Title"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/sp_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        tools:text="Cornes de gazelle" />

                    <LinearLayout
                        android:id="@+id/layoutTodoPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTodoFrom"
                            style="@style/Hesba.Bento.Mono"
                            android:fontFamily="@font/hb_mono_medium"
                            android:textColor="@color/hb_bento_bad_ink"
                            android:textSize="13sp"
                            tools:text="2,4 %" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="@dimen/sp_2"
                            android:layout_marginEnd="@dimen/sp_2"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/hb_bento_ink_soft" />

                        <TextView
                            android:id="@+id/txtTodoTo"
                            style="@style/Hesba.Bento.Mono"
                            android:fontFamily="@font/hb_mono_medium"
                            android:textColor="@color/hb_bento_good_ink"
                            android:textSize="13sp"
                            tools:text="55 %" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="@dimen/sp_3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTodoBody"
                            style="@style/Hesba.Bento.Sub"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textAlignment="viewStart"
                            tools:text="Vendue 0,900 DT · coût 0,878 DT" />

                        <TextView
                            android:id="@+id/btnTodo"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/sp_3"
                            android:background="@drawable/bg_bento_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/hb_sans_semibold"
                            android:gravity="center"
                            android:paddingStart="@dimen/sp_4"
                            android:paddingEnd="@dimen/sp_4"
                            android:textColor="@color/hb_bento_label"
                            android:textSize="13sp"
                            tools:text="Mettre à 1,950 DT" />
                    </LinearLayout>
                </LinearLayout>

                <!-- rangées 7-8 : meilleure marge (haut) | simulateur + courses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardBest"
                        style="@style/Hesba.Bento.Card"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_bento_good"
                        android:elevation="0dp"
                        android:orientation="vertical"
                        android:padding="@dimen/bento_pad">

                        <TextView
                            android:id="@+id/txtBestLabel"
                            style="@style/Hesba.Bento.Label"
                            android:textColor="@color/hb_bento_good_ink"
                            tools:text="Meilleure marge" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtBestValue"
                            style="@style/Hesba.Bento.Big"
                            android:textColor="@color/hb_bento_good_ink"
                            android:textSize="32sp"
                            tools:text="60,3 %" />

                        <TextView
                            android:id="@+id/txtBestName"
                            style="@style/Hesba.Bento.Name"
                            android:layout_width="match_parent"
                            android:layout_marginTop="2dp"
                            android:textAlignment="viewStart"
                            android:textSize="15sp"
                            tools:text="Pain au lait" />

                        <TextView
                            android:id="@+id/txtBestSub"
                            style="@style/Hesba.Bento.Mono"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/hb_bento_good_soft"
                            tools:text="0,700 DT · coût 0,278" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/bento_gap"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardSimulator"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_simulate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/sp_3"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Hesba.Bento.Name"
                                    android:text="@string/bento_sim_title" />

                                <TextView
                                    style="@style/Hesba.Bento.Sub"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/bento_sim_sub"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bento_gap" />

                        <LinearLayout
                            android:id="@+id/cardShopping"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_cart" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/sp_3"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Hesba.Bento.Name"
                                    android:text="@string/bento_shop_title" />

                                <TextView
                                    style="@style/Hesba.Bento.Sub"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/bento_shop_sub"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Toutes les alertes : s'ouvre depuis la carte « à corriger » -->
            <LinearLayout
                android:id="@+id/alertsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtAlertsTitle"
                    style="@style/Hesba.Section"
                    android:text="@string/home_alerts" />

                <LinearLayout
                    android:id="@+id/listAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
