<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil (design Minimal) :
     barre ardoise « Hesba » + cercle d'initiales ; salutation ; 2 cartes chiffres ; carte « Dernier calcul » ;
     bouton principal « Nouvelle recette » ; puis les cartes « Suivi et outils » (ancienne grille, restylée).
     Grille : rangée = 80 dp, carte haute = 172 dp, espace 12 dp (dimens_bento.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <!-- barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/hesba_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/space_s">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name_display"
            android:textAppearance="@style/Hesba.Text.Toolbar" />

        <!-- profil : initiale du prénom ou du commerce, sinon l'icône -->
        <FrameLayout
            android:id="@+id/btnProfile"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/tab_profile"
            android:focusable="true">

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_bento_avatar"
                android:fontFamily="@font/hb_sans_bold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/hesba_text_primary"
                android:textSize="16sp"
                tools:text="E" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile"
                android:visibility="gone"
                app:tint="@color/hesba_text_primary" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- salutation + date · commerce -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/Hesba.Text.Title"
                    tools:text="Bonsoir, Eya" />

                <TextView
                    android:id="@+id/txtHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/Hesba.Text.Caption"
                    tools:text="samedi 15 novembre · Pâtisserie Eya" />
            </LinearLayout>

            <!-- 2 cartes chiffres -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardStatRecipes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/txtStatRecipes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/Hesba.Text.Amount"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_stat_recipes"
                        android:textAppearance="@style/Hesba.Text.Caption" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/card_gap"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:id="@+id/cardStatIngredients"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/txtStatIngredients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/Hesba.Text.Amount"
                        tools:text="34" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/tab_ingredients"
                        android:textAppearance="@style/Hesba.Text.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dernier calcul -->
            <LinearLayout
                android:id="@+id/cardLastCalc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/txtLastCalcName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_last_calc"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/Hesba.Text.Caption"
                    tools:text="Dernier calcul · Cornes de gazelle" />

                <LinearLayout
                    android:id="@+id/layoutLastCalcCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_cost_per_portion"
                            android:textAppearance="@style/Hesba.Text.Caption" />

                        <TextView
                            android:id="@+id/txtLastCalcCost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Hesba.Text.Amount"
                            tools:text="0,878 DT" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtLastCalcBadge"
                        style="@style/Hesba.Badge.Success"
                        android:layout_marginStart="@dimen/space_s"
                        android:visibility="gone"
                        tools:text="Marge OK · 55 %"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLastCalcSuggested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/Hesba.Text.Body"
                    tools:text="Prix conseillé : 1,950 DT" />
            </LinearLayout>

            <!-- seul bouton principal de l'écran -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewRecipe"
                style="@style/Hesba.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_new_recipe"
                app:icon="@drawable/ic_add" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:accessibilityHeading="true"
                android:text="@string/home_tools"
                android:textAppearance="@style/Hesba.Text.Title" />

            <!-- Grille « Suivi et outils », toujours affichée (sans données, la carte « À faire maintenant » guide
                 le premier usage) ; cachée jusqu'aux premières données pour ne pas clignoter -->
            <LinearLayout
                android:id="@+id/bento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1 · Marge moyenne (toute la largeur, 2 rangées) -->
                <LinearLayout
                    android:id="@+id/cardMargin"
                    style="@style/Hesba.Bento.Card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_weight="0"
                    android:background="@drawable/bg_bento_hero"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Hesba.Bento.Label"
                            android:text="@string/bento_margin_label" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtMargin"
                            style="@style/Hesba.Bento.Big"
                            tools:text="44,3 %" />

                        <TextView
                            android:id="@+id/txtMarginSub"
                            style="@style/Hesba.Bento.Sub"
                            android:layout_marginTop="@dimen/space_xs"
                            tools:text="objectif moyen 60 % · 4 recettes" />
                    </LinearLayout>

                    <com.example.hesba.ui.widget.MarginRingView
                        android:id="@+id/ringMargin"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="@dimen/space_m" />
                </LinearLayout>

                <!-- scanner (haut) | à corriger + prix -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardScan"
                        style="@style/Hesba.Bento.Card"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_bento_scan"
                        android:orientation="vertical"
                        android:padding="@dimen/bento_pad">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_bento_chip">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_scan"
                                app:tint="@color/hesba_accent_text" />
                        </FrameLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Hesba.Bento.Title"
                            android:text="@string/action_scan_invoice" />

                        <TextView
                            style="@style/Hesba.Bento.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/bento_scan_sub" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/bento_gap"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardFix"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:background="@drawable/bg_bento_bad"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtFixCount"
                                    style="@style/Hesba.Bento.Big"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    android:textSize="24sp"
                                    tools:text="4" />

                                <TextView
                                    android:id="@+id/txtFixLabel"
                                    style="@style/Hesba.Bento.Sub"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    tools:text="à corriger" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/imgFix"
                                style="@style/Hesba.Bento.Icon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_alert"
                                app:tint="@color/hb_bento_bad_icon" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bento_gap" />

                        <LinearLayout
                            android:id="@+id/cardPrice"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtPriceName"
                                    style="@style/Hesba.Bento.Name"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    tools:text="Beurre" />

                                <TextView
                                    android:id="@+id/txtPriceDelta"
                                    style="@style/Hesba.Bento.Mono"
                                    android:layout_marginStart="@dimen/space_s"
                                    android:fontFamily="@font/hb_mono_medium"
                                    android:textColor="@color/hb_bento_bad_ink"
                                    tools:text="+12,8 %" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtPriceFrom"
                                style="@style/Hesba.Bento.Mono"
                                android:layout_width="match_parent"
                                android:layout_marginTop="@dimen/space_xs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAlignment="viewStart"
                                tools:text="3,900 → 4,400 DT" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- une action à faire maintenant -->
                <LinearLayout
                    android:id="@+id/cardTodo"
                    style="@style/Hesba.Bento.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:layout_weight="0"
                    android:minHeight="@dimen/bento_tall"
                    android:orientation="vertical"
                    android:padding="@dimen/bento_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hesba.Bento.Label"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/bento_todo_label" />

                        <TextView
                            android:id="@+id/btnNextAlert"
                            style="@style/Hesba.Bento.Mono"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="@dimen/touch"
                            android:paddingStart="@dimen/space_s"
                            android:paddingEnd="@dimen/space_s"
                            tools:text="1 / 4  ›" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTodoTitle"
                        style="@style/Hesba.Bento.Title"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_s"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        tools:text="Cornes de gazelle" />

                    <LinearLayout
                        android:id="@+id/layoutTodoPath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTodoFrom"
                            style="@style/Hesba.Bento.Mono"
                            android:fontFamily="@font/hb_mono_medium"
                            android:textColor="@color/hb_bento_bad_ink"
                            android:textSize="13sp"
                            tools:text="2,4 %" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/hesba_text_secondary" />

                        <TextView
                            android:id="@+id/txtTodoTo"
                            style="@style/Hesba.Bento.Mono"
                            android:fontFamily="@font/hb_mono_medium"
                            android:textColor="@color/hb_bento_good_ink"
                            android:textSize="13sp"
                            tools:text="55 %" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="@dimen/space_m" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTodoBody"
                            style="@style/Hesba.Bento.Sub"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textAlignment="viewStart"
                            tools:text="Vendue 0,900 DT · coût 0,878 DT" />

                        <!-- action secondaire (contour), le bouton principal de l'écran reste « Nouvelle recette » -->
                        <TextView
                            android:id="@+id/btnTodo"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/space_m"
                            android:background="@drawable/bg_bento_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/hb_sans_semibold"
                            android:gravity="center"
                            android:paddingStart="@dimen/space_l"
                            android:paddingEnd="@dimen/space_l"
                            android:textColor="@color/hesba_text_primary"
                            android:textSize="13sp"
                            tools:text="Mettre à 1,950 DT" />
                    </LinearLayout>
                </LinearLayout>

                <!-- meilleure marge (haut) | simulateur + courses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bento_tall"
                    android:layout_marginTop="@dimen/bento_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardBest"
                        style="@style/Hesba.Bento.Card"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_bento_good"
                        android:orientation="vertical"
                        android:padding="@dimen/bento_pad">

                        <TextView
                            android:id="@+id/txtBestLabel"
                            style="@style/Hesba.Bento.Label"
                            android:textColor="@color/hb_bento_good_ink"
                            tools:text="Meilleure marge" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/txtBestValue"
                            style="@style/Hesba.Bento.Big"
                            android:textColor="@color/hb_bento_good_ink"
                            android:textSize="28sp"
                            tools:text="60,3 %" />

                        <TextView
                            android:id="@+id/txtBestName"
                            style="@style/Hesba.Bento.Name"
                            android:layout_width="match_parent"
                            android:layout_marginTop="2dp"
                            android:textAlignment="viewStart"
                            android:textSize="15sp"
                            tools:text="Pain au lait" />

                        <TextView
                            android:id="@+id/txtBestSub"
                            style="@style/Hesba.Bento.Mono"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/hb_bento_good_soft"
                            tools:text="0,700 DT · coût 0,278" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/bento_gap"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardSimulator"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_simulate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_m"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Hesba.Bento.Name"
                                    android:text="@string/bento_sim_title" />

                                <TextView
                                    style="@style/Hesba.Bento.Sub"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/bento_sim_sub"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bento_gap" />

                        <LinearLayout
                            android:id="@+id/cardShopping"
                            style="@style/Hesba.Bento.Card"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Hesba.Bento.Icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cart" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_m"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Hesba.Bento.Name"
                                    android:text="@string/bento_shop_title" />

                                <TextView
                                    style="@style/Hesba.Bento.Sub"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/bento_shop_sub"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Toutes les alertes : s'ouvre depuis la carte « à corriger » -->
            <LinearLayout
                android:id="@+id/alertsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtAlertsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:layout_marginBottom="@dimen/space_s"
                    android:accessibilityHeading="true"
                    android:text="@string/home_alerts"
