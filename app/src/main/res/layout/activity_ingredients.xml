<?xml version="1.0" encoding="utf-8"?>
<!-- Ingrédients : titre et recherche sur le papier, puis l'ardoise du marché (liste des prix) jusqu'à la barre du bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/sp_4">

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_5"
            android:textAppearance="@style/TextAppearance.Hesba.Section" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityHeading="true"
            android:text="@string/tab_ingredients"
            android:textAppearance="@style/TextAppearance.Hesba.Display" />

        <include
            android:id="@+id/search"
            layout="@layout/view_search" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/slate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_slate"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="18dp"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/slate_title"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Hesba.Section"
                    android:textColor="@color/hb_chalk_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/col_price_paid"
                    android:textAppearance="@style/TextAppearance.Hesba.Section"
                    android:textColor="@color/hb_chalk_soft" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/list_bottom_clearance" />
        </LinearLayout>

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Hesba.AddSquare"
            android:contentDescription="@string/action_add_ingredient" />
    </FrameLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
