<?xml version="1.0" encoding="utf-8"?>
<!-- Écran secondaire générique (design Minimal) : Statistiques, Factures.
     Barre ardoise avec retour, introduction, filtres facultatifs, contenu défilant, état vide, bouton collé en bas facultatif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/txtIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Hesba.Text.Body"
                android:textColor="@color/hesba_text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- bouton collé en bas (Factures) : seul bouton principal de l'écran -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_bar"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFooter"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
