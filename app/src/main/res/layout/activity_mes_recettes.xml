<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6EE"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nombre de recettes -->
            <TextView
                android:id="@+id/tvNombreRecettes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 recette enregistrée"
                android:textColor="#8C7A6B"
                android:textSize="13sp" />

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="serif"
                android:text="Mes recettes"
                android:textColor="#2D1E18"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Message d'absence de recettes -->
            <TextView
                android:id="@+id/tvAucuneRecette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aucune recette enregistrée pour le moment."
                android:textColor="#8C7A6B"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Conteneur des cartes de recettes -->
            <LinearLayout
                android:id="@+id/containerRecettes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bouton "+ Nouvelle recette" fixe en bas -->
    <Button
        android:id="@+id/btnNouvelle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_button"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="+ Nouvelle recette"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
