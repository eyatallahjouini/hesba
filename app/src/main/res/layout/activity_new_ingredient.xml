<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnBack" android:layout_width="44dp" android:text="‹" android:textColor="@color/brun" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:layout_height="44dp" android:background="@drawable/bg_back" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nouvel ingrédient" android:textColor="@color/brun" android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif"/>
        </LinearLayout>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Nom" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <EditText android:id="@+id/editIngredientName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="textCapSentences" android:maxLines="1" android:hint="Ex. Farine"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tu l'achètes en…" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <RadioGroup android:id="@+id/rgUnit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <RadioButton android:id="@+id/rbKg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="8dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:checked="true" android:text="kg"/>
        <RadioButton android:id="@+id/rbLiter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="8dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:text="L"/>
        <RadioButton android:id="@+id/rbPiece" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="8dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:text="Pièce"/>
        <RadioButton android:id="@+id/rbPack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="0dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:text="Boîte"/>
      </RadioGroup>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:weightSum="2">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Quantité dans l'emballage" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
          <EditText android:id="@+id/editPackageQty" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="numberDecimal" android:maxLines="1" android:hint="1000"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Prix payé (dt)" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
          <EditText android:id="@+id/editPrice" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="numberDecimal" android:maxLines="1" android:hint="6,00"/>
        </LinearLayout>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="En grammes (g), millilitres (ml) ou pièces." android:textColor="@color/brun_clair" android:textSize="13sp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_alert" android:padding="18dp" android:layout_marginTop="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ça fait" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        <TextView android:id="@+id/txtPerUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0,006 dt par gramme" android:textColor="@color/brun" android:textSize="26sp" android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tu pourras changer le prix quand tu veux : tes recettes se recalculent." android:textColor="@color/brun_clair" android:textSize="14sp"/>
      </LinearLayout>
      <Button android:id="@+id/btnSaveIngredient" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Enregistrer" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/brun" android:backgroundTint="@color/safran" app:cornerRadius="16dp"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
