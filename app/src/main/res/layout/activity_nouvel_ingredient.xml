<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_5">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_ingredient_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editName"
                    style="@style/Widget.Hesba.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_purchase" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ingredient_purchase_note"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                app:checkedChip="@id/unitKg"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/unitKg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/unit_kg" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/unitG"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/unit_g" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/unitL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/unit_l" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/unitMl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/unit_ml" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/unitPiece"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/unit_piece" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilQuantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:layout_marginEnd="@dimen/sp_2"
                    android:layout_weight="1"
                    android:hint="@string/field_package_quantity">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editQuantity"
                        style="@style/Widget.Hesba.EditText.Money"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:layout_marginStart="@dimen/sp_2"
                    android:layout_weight="1"
                    android:hint="@string/field_price_paid"
                    app:suffixText="@string/currency_short">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPrice"
                        style="@style/Widget.Hesba.EditText.Money"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_yield" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilYield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_yield"
                app:helperText="@string/helper_yield"
                app:suffixText="@string/percent_sign">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editYield"
                    style="@style/Widget.Hesba.EditText.Money"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- explication en direct du prix réel -->
            <TextView
                android:id="@+id/txtLive"
                style="@style/Hesba.Note"
                android:layout_marginTop="@dimen/sp_4"
                android:accessibilityLiveRegion="polite"
                android:fontFeatureSettings="tnum" />

            <!-- Autres noms (factures, arabe…) -->
            <LinearLayout
                android:id="@+id/blockSynonyms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Hesba.Section"
                    android:text="@string/section_synonyms" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/synonyms_note"
                    android:textAppearance="@style/TextAppearance.Hesba.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupSynonyms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSynonym"
                    style="@style/Widget.Hesba.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_add_synonym"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- Utilisé dans -->
            <LinearLayout
                android:id="@+id/blockUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtUsageTitle"
                    style="@style/Hesba.Section" />

                <TextView
                    android:id="@+id/txtUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hesba.Body" />
            </LinearLayout>

            <!-- Historique des prix -->
            <LinearLayout
                android:id="@+id/blockHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Hesba.Section"
                    android:text="@string/section_history" />

                <View style="@style/Hesba.Divider" />

                <LinearLayout
                    android:id="@+id/listHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Hesba.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_5"
                android:text="@string/action_delete_ingredient"
                android:visibility="gone"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View style="@style/Hesba.Divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/sp_3"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/sp_3"
        android:text="@string/action_save" />
</LinearLayout>
