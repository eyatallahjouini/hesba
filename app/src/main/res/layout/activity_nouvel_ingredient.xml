<?xml version="1.0" encoding="utf-8"?>
<!-- Ajouter / modifier un ingrédient (design Minimal) : barre ardoise avec retour ; cartes « Ingrédient »,
     « Achat » (quantité + unité en liste déroulante, prix), « Rendement », autres noms, utilisation, historique ;
     seul bouton principal « Enregistrer » collé en bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== Carte : nom et achat ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_ingredient_name"
                        app:startIconDrawable="@drawable/ic_ingredients">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editName"
                            style="@style/Widget.Hesba.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:accessibilityHeading="true"
                        android:text="@string/section_purchase"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/ingredient_purchase_note"
                        android:textAppearance="@style/Hesba.Text.Caption" />

                    <!-- état de l'unité lu par le code ; l'utilisateur choisit dans la liste déroulante ci-dessous -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:checkedChip="@id/unitKg"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/unitKg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/unit_kg" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/unitG"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/unit_g" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/unitL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/unit_l" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/unitMl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/unit_ml" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/unitPiece"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/unit_piece" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilQuantity"
                            style="@style/Hesba.Field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            android:hint="@string/field_package_quantity">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editQuantity"
                                style="@style/Widget.Hesba.EditText.Money"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUnit"
                            style="@style/Hesba.Field.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:hint="@string/field_unit">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/dropUnit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/hb_sans"
                                android:inputType="none"
                                android:textColor="@color/hesba_text_primary"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPrice"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:hint="@string/field_price_paid"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPrice"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Carte : rendement ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_m"
                        android:accessibilityHeading="true"
                        android:text="@string/section_yield"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilYield"
                        style="@style/Hesba.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_yield"
                        app:helperText="@string/helper_yield"
                        app:suffixText="@string/percent_sign">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editYield"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- explication en direct du prix réel -->
                    <TextView
                        android:id="@+id/txtLive"
                        style="@style/Hesba.Note"
                        android:layout_marginTop="@dimen/space_m"
                        android:accessibilityLiveRegion="polite"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Carte : autres noms (factures, arabe…) ===== -->
            <LinearLayout
                android:id="@+id/blockSynonyms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_advisor"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/section_synonyms"
                    android:textAppearance="@style/Hesba.Text.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/synonyms_note"
                    android:textAppearance="@style/Hesba.Text.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupSynonyms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSynonym"
                    style="@style/Hesba.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_add_synonym"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- ===== Carte : utilisé dans ===== -->
            <LinearLayout
                android:id="@+id/blockUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_advisor"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtUsageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/Hesba.Text.Title" />

                <TextView
                    android:id="@+id/txtUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Hesba.Text.Body" />
            </LinearLayout>

            <!-- ===== Carte : historique des prix ===== -->
            <LinearLayout
                android:id="@+id/blockHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_advisor"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/section_history"
                    android:textAppearance="@style/Hesba.Text.Title" />

                <LinearLayout
                    android:id="@+id/listHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:divider="@drawable/divider_hairline"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Hesba.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_delete_ingredient"
                android:visibility="gone"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- seul bouton principal de l'écran, collé en bas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_bar"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save" />
    </FrameLayout>
</LinearLayout>
