<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F2"
    android:fillViewport="true"
    android:padding="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- En-tête : Bouton Retour et Titre -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_white"
            android:contentDescription="Retour"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Nouvel ingrédient"
            android:textColor="#2D2013"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <!-- Champ Nom -->
        <TextView
            android:id="@+id/lblNom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nom"
            android:textColor="#2D2013"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <EditText
            android:id="@+id/etNomIngredient"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Harissa"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"
            android:textColor="#2D2013"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/lblNom" />

        <!-- Sélection Unité -->
        <TextView
            android:id="@+id/lblUnite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tu l'achètes en..."
            android:textColor="#2D2013"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNomIngredient" />

        <!-- RadioGroup personnalisé / Chips sous forme de grille/ligne -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupUnite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintTop_toBottomOf="@id/lblUnite">

            <Button
                android:id="@+id/btnKg"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kilo (kg)"
                android:textAllCaps="false"
                android:textColor="#2D2013" />

            <Button
                android:id="@+id/btnLitre"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Litre (L)"
                android:textAllCaps="false"
                android:textColor="#2D2013" />

            <Button
                android:id="@+id/btnPiece"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pièce"
                android:textAllCaps="false"
                android:textColor="#2D2013" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Button
            android:id="@+id/btnBoite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Boite / sachet"
            android:textAllCaps="false"
            android:textColor="#2D2013"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupUnite" />

        <!-- Quantité et Prix (2 Colonnes) -->
        <TextView
            android:id="@+id/lblQuantite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp"
            android:text="Quantité dans l'emballage"
            android:textColor="#2D2013"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/lblPrix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBoite" />

        <TextView
            android:id="@+id/lblPrix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Prix payé (dt)"
            android:textColor="#2D2013"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/lblQuantite"
            app:layout_constraintTop_toTopOf="@id/lblQuantite" />

        <EditText
            android:id="@+id/etQuantite"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="1 kg"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#2D2013"
            app:layout_constraintEnd_toStartOf="@id/etPrix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblQuantite" />

        <EditText
            android:id="@+id/etPrix"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="6,00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="#2D2013"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etQuantite"
            app:layout_constraintTop_toTopOf="@id/etQuantite" />

        <!-- Encart de Calcul (Ca fait X dt par gramme) -->
        <LinearLayout
            android:id="@+id/cardResultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_beige"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/etQuantite">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ça fait"
                android:textColor="#7A6855"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPrixUnitaireCalcul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:text="0,006 dt par gramme"
                android:textColor="#2D2013"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu pourras changer le prix quand tu veux : tes recettes se recalculent."
                android:textColor="#7A6855"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bouton Enregistrer -->
        <Button
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#F28827"
            android:text="Enregistrer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardResultat"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>