<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête : Bouton retour + Titre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRetour"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_rounded_white"
                android:contentDescription="Retour"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Nouvelle recette"
                android:textColor="#2A1B12"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zone d'ajout de photo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FAF6F0"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#D3C9BF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#6D4C41" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ajouter une photo"
                    android:textColor="#2A1B12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_pill_beige"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="Facultatif"
                    android:textColor="#8D6E63"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Saisie : Nom de la recette -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nom de la recette"
            android:textColor="#2A1B12"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNomRecette"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Ex. Gâteau au chocolat"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"
            android:textColor="#2A1B12"
            android:textColorHint="#A0958C"
            android:textSize="14sp" />

        <!-- Saisie : Nombre de parts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre de parts"
            android:textColor="#2A1B12"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreParts"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="12"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#2A1B12"
            android:textColorHint="#A0958C"
            android:textSize="14sp" />

        <!-- Card Ingrédients -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingrédients"
                    android:textColor="#2A1B12"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Liste dynamique des ingrédients sélectionnés -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_ingredient_selection" />

                <!-- Bouton Ajouter un ingrédient -->
                <Button
                    android:id="@+id/btnAjouterIngredient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="+ Ajouter un ingrédient"
                    android:textColor="#B35C1E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bouton d'action principal -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalculer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button"
            android:text="Calculer le coût"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>