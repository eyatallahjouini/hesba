<?xml version="1.0" encoding="utf-8"?>
<!-- Premier lancement (design Minimal) : 1. l'histoire (phrases + carte de coût qui se remplit), 2. la langue, 3. le compte. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background">

    <!-- ===== 1. Histoire ===== -->
    <LinearLayout
        android:id="@+id/pageStory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- logo Hesba (décoratif) + nom -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/space_s"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_hesba" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/hb_sans_bold"
                android:importantForAccessibility="no"
                android:text="@string/app_name_display"
                android:textAlignment="viewStart"
                android:textAppearance="@style/Hesba.Text.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkip"
                style="@style/Hesba.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_skip"
                android:textColor="@color/hesba_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/onb_line1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Hesba.Lead" />

        <TextView
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/onb_line2"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Hesba.Lead"
            android:textColor="@color/hesba_accent_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <com.example.hesba.ui.widget.ReceiptLayout
                    android:id="@+id/storyReceipt"
                    android:layout_width="272dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/onb_receipt_cd"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:padding="@dimen/card_padding"
                    app:flat="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/onb_receipt_title"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@color/hesba_border" />

                    <LinearLayout
                        android:id="@+id/storyLines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical" />

                    <com.example.hesba.ui.widget.DotLeaderView
                        android:id="@+id/storyRule"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_xs"
                        app:dotColor="@color/hesba_border_strong" />

                    <LinearLayout
                        android:id="@+id/storyTotals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical" />
                </com.example.hesba.ui.widget.ReceiptLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/line3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onb_line3"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Hesba.Lead" />

        <LinearLayout
            android:id="@+id/nextRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onb_hint_next"
                android:textAlignment="viewStart"
                android:textAppearance="@style/Hesba.Text.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Hesba.AddSquare"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="0dp"
                android:elevation="0dp"
                android:contentDescription="@string/onb_continue"
                app:icon="@drawable/ic_arrow_forward" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 2. Langue ===== -->
    <LinearLayout
        android:id="@+id/pageLanguage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:accessibilityHeading="true"
            android:text="@string/onb_lang_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/onb_lang_sub"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Caption" />

        <LinearLayout
            android:id="@+id/langOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLangNext"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/onb_continue"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>

    <!-- ===== 3. Compte ===== -->
    <LinearLayout
        android:id="@+id/pageAccount"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone">

        <!-- logo Hesba (décoratif) + nom, comme en haut de la page 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/space_s"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_hesba" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hb_sans_bold"
                android:importantForAccessibility="no"
                android:text="@string/app_name_display"
                android:textAppearance="@style/Hesba.Text.Title" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:accessibilityHeading="true"
            android:text="@string/onb_account_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/onb_account_body"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Body"
            android:textColor="@color/hesba_text_secondary" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onb_create" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Hesba.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/onb_login" />
    </LinearLayout>
</FrameLayout>
