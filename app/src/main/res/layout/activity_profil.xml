<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:orientation="vertical">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Ton compte"
          android:textColor="@color/brun_clair"
          android:textSize="15sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="serif"
          android:text="Mon profil"
          android:textColor="@color/brun"
          android:textSize="32sp"
          android:textStyle="bold" />

      <!-- Carte du profil -->
      <LinearLayout
          android:id="@+id/cardProfile"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:background="@drawable/bg_card"
          android:orientation="vertical"
          android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

          <TextView
              android:id="@+id/txtInitial"
              android:layout_width="56dp"
              android:layout_height="56dp"
              android:background="@drawable/bg_logo"
              android:fontFamily="serif"
              android:gravity="center"
              android:text="?"
              android:textColor="@color/brun"
              android:textSize="26sp"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/txtFirstName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="14dp"
              android:layout_weight="1"
              android:fontFamily="serif"
              android:text="Prénom"
              android:textColor="@color/brun"
              android:textSize="22sp"
              android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email"
            android:textColor="@color/brun_clair"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="@color/brun"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/caramel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Activité"
            android:textColor="@color/brun_clair"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="@color/brun"
            android:textSize="17sp"
            android:textStyle="bold" />
      </LinearLayout>

      <!-- SECTION 1 : Modification de l'activité & personnel -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="Modifier ton activité"
          android:textColor="@color/brun"
          android:textSize="16sp"
          android:textStyle="bold" />

      <RadioGroup
          android:id="@+id/rgActivity"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:button="@null"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="À domicile"
            android:textColor="@color/brun"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbLocalSolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:button="@null"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="Local sans employé"
            android:textColor="@color/brun"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbLocalStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:button="@null"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="Local avec employés"
            android:textColor="@color/brun"
            android:textSize="15sp"
            android:textStyle="bold" />
      </RadioGroup>
      <!-- Volume estimé (s'affiche aussi quand un local est choisi) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="Production mensuelle estimée (parts / mois)"
          android:textColor="@color/brun"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editMonthlyVolume"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="6dp"
          android:background="@drawable/bg_input"
          android:hint="Ex: 300"
          android:inputType="number"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />

      <!-- Section dynamique pour le Loyer du Local (solo et avec employés) -->
      <LinearLayout
          android:id="@+id/layoutRentField"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loyer / Charges fixes du local (DT / mois)"
            android:textColor="@color/brun"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editRent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Ex: 800.00"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brun"
            android:textColorHint="@color/gris_hint"
            android:textSize="16sp" />
      </LinearLayout>

      <!-- Section dynamique pour les détails des employés (uniquement avec employés) -->
      <LinearLayout
          android:id="@+id/layoutEmployeeFields"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nombre d'employés"
            android:textColor="@color/brun"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editEmpCount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Ex: 2"
            android:inputType="number"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brun"
            android:textColorHint="@color/gris_hint"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Salaire mensuel moyen par employé (DT)"
            android:textColor="@color/brun"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editEmpSalary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Ex: 1200.00"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/brun"
            android:textColorHint="@color/gris_hint"
            android:textSize="16sp" />
      </LinearLayout>

      <Button
          android:id="@+id/btnSaveProfile"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="16dp"
          android:backgroundTint="@color/safran"
          android:text="Enregistrer l'activité"
          android:textAllCaps="false"
          android:textColor="@color/brun"
          android:textSize="15sp"
          android:textStyle="bold"
          app:cornerRadius="12dp" />

      <!-- SECTION 2 : Modification du mot de passe -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:text="Sécurité"
          android:textColor="@color/brun"
          android:textSize="16sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/editCurrentPassword"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="8dp"
          android:background="@drawable/bg_input"
          android:hint="Mot de passe actuel"
          android:inputType="textPassword"
          android:maxLines="1"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />

      <EditText
          android:id="@+id/editNewPassword"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/bg_input"
          android:hint="Nouveau mot de passe (6 car. min.)"
          android:inputType="textPassword"
          android:maxLines="1"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:textColor="@color/brun"
          android:textColorHint="@color/gris_hint"
          android:textSize="16sp" />

      <Button
          android:id="@+id/btnChangePassword"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="16dp"
          android:backgroundTint="@color/brun"
          android:text="Changer le mot de passe"
          android:textAllCaps="false"
          android:textColor="@color/creme"
          android:textSize="15sp"
          android:textStyle="bold"
          app:cornerRadius="12dp" />

      <!-- Message informatif pour le mode invité -->
      <TextView
          android:id="@+id/txtNoProfile"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:background="@drawable/bg_card"
          android:padding="18dp"
          android:text="Vous utilisez l'application en mode essai. Créez un compte pour enregistrer vos données personnelles."
          android:textColor="@color/brun_clair"
          android:textSize="15sp"
          android:visibility="gone" />

      <!-- Bouton Créer un compte (Affiché pour les invités) -->
      <Button
          android:id="@+id/btnCreateAccount"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="20dp"
          android:backgroundTint="@color/safran"
          android:text="Créer un compte"
          android:textAllCaps="false"
          android:textColor="@color/brun"
          android:textSize="16sp"
          android:textStyle="bold"
          android:visibility="gone"
          app:cornerRadius="12dp" />

      <!-- Bouton Se déconnecter / Quitter la session -->
      <Button
          android:id="@+id/btnLogout"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="12dp"
          android:backgroundTint="@color/brun_clair"
          android:text="Se déconnecter"
          android:textAllCaps="false"
          android:textColor="@color/creme"
          android:textSize="15sp"
          android:textStyle="bold"
          android:visibility="visible"
          app:cornerRadius="12dp" />

    </LinearLayout>
  </ScrollView>

  <include layout="@layout/view_bottom_nav" />
</LinearLayout>