<?xml version="1.0" encoding="utf-8"?>
<!-- Profil (design Minimal) : barre ardoise ; en-tête (cercle d'initiales, nom, e-mail) ;
     mode essai ou cartes « Mon commerce » et « Charges » ; cartes de réglages (icône, titre, chevron) ;
     « Se déconnecter » en texte rouge ; version. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <!-- barre du haut (écran d'onglet : pas de retour) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/hesba_primary"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/tab_profile"
            android:textAppearance="@style/Hesba.Text.Toolbar" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== En-tête : identité ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtMonogram"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_monogram"
                        android:fontFamily="@font/hb_sans_bold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:textColor="@color/hesba_text_primary"
                        android:textSize="26sp"
                        tools:text="E" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/Hesba.Text.Title"
                            tools:text="Eya" />

                        <TextView
                            android:id="@+id/txtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/Hesba.Text.Caption"
                            tools:text="eya@exemple.tn" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Mode essai ===== -->
            <LinearLayout
                android:id="@+id/blockGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_advisor"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    style="@style/Hesba.Note"
                    android:text="@string/profile_guest_note" />

                <!-- bouton principal de l'écran en mode essai -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    style="@style/Hesba.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/action_create_account" />
            </LinearLayout>

            <!-- ===== Mon commerce + charges (compte connecté) ===== -->
            <LinearLayout
                android:id="@+id/blockBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_m"
                            android:accessibilityHeading="true"
                            android:text="@string/section_business"
                            android:textAppearance="@style/Hesba.Text.Title" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFirstName"
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/field_first_name"
                            app:startIconDrawable="@drawable/ic_profile">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editFirstName"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:hint="@string/field_business_name"
                            app:startIconDrawable="@drawable/ic_home">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editBusiness"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:hint="@string/field_city">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editCity"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_l"
                            android:text="@string/section_activity"
                            android:textAppearance="@style/Hesba.Text.Body"
                            android:fontFamily="@font/hb_sans_medium" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/groupActivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/activity_home" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSolo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/activity_solo" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipStaff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/activity_staff" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Charges (travail d'Aya, sans valeurs inventées) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/section_charges"
                            android:textAppearance="@style/Hesba.Text.Title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/charges_note"
                            android:textAppearance="@style/Hesba.Text.Caption" />

                        <LinearLayout
                            android:id="@+id/blockRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Hesba.Field"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_s"
                                android:layout_weight="1"
                                android:hint="@string/field_rent"
                                app:suffixText="@string/currency_short">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editRent"
                                    style="@style/Widget.Hesba.EditText.Money"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilVolume"
                                style="@style/Hesba.Field"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                android:hint="@string/field_volume">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editVolume"
                                    style="@style/Widget.Hesba.EditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:inputType="number"
                                    android:maxLength="7" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmployees"
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:hint="@string/field_employees">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editEmployees"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSalary"
                                style="@style/Hesba.Field"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:layout_marginEnd="@dimen/space_s"
                                android:layout_weight="1"
                                android:hint="@string/field_salary"
                                app:suffixText="@string/currency_short">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editSalary"
                                    style="@style/Widget.Hesba.EditText.Money"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilHours"
                                style="@style/Hesba.Field"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                android:hint="@string/field_hours">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editHours"
                                    style="@style/Widget.Hesba.EditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:inputType="number"
                                    android:maxLength="3" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtChargesPreview"
                            style="@style/Hesba.Note"
                            android:layout_marginTop="@dimen/space_m"
                            android:accessibilityLiveRegion="polite"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/Hesba.Text.Caption"
                            android:textColor="@color/hesba_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- bouton principal de l'écran pour un compte connecté -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveProfile"
                    style="@style/Hesba.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/action_save_profile" />
            </LinearLayout>

            <!-- ===== Réglages : préférences ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:contentPaddingBottom="0dp"
                app:contentPaddingTop="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:accessibilityHeading="true"
                        android:text="@string/section_preferences"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <include
                        android:id="@+id/rowLanguage"
                        layout="@layout/item_link" />

                    <include
                        android:id="@+id/rowTheme"
                        layout="@layout/item_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Réglages : données ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                app:contentPaddingBottom="0dp"
                app:contentPaddingTop="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:accessibilityHeading="true"
                        android:text="@string/section_data"
                        android:textAppearance="@style/Hesba.Text.Title" />

                    <include
                        android:id="@+id/rowBackup"
                        layout="@layout/item_link" />

                    <include
                        android:id="@+id/rowRestore"
                        layout="@layout/item_link" />

                    <include
                        android:id="@+id/rowInvoices"
                        layout="@layout/item_link" />

                    <include
                        android:id="@+id/rowPassword"
                        layout="@layout/item_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- action destructive en texte rouge -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Hesba.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_logout"
                app:icon="@drawable/ic_logout" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:textAppearance="@style/Hesba.Text.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
