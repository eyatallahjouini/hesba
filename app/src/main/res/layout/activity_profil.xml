<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_5"
                android:accessibilityHeading="true"
                android:text="@string/tab_profile"
                android:textAppearance="@style/TextAppearance.Hesba.Display" />

            <!-- Identité -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtMonogram"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_monogram"
                    android:fontFamily="@font/hb_sans_bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/hb_accent_ink"
                    android:textSize="24sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sp_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Hesba.Subtitle" />

                    <TextView
                        android:id="@+id/txtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Hesba.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mode essai -->
            <LinearLayout
                android:id="@+id/blockGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Hesba.Note"
                    android:text="@string/profile_guest_note" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:text="@string/action_create_account" />
            </LinearLayout>

            <!-- Mon commerce -->
            <LinearLayout
                android:id="@+id/blockBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Hesba.Section"
                    android:text="@string/section_business" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_first_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFirstName"
                        style="@style/Widget.Hesba.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:hint="@string/field_business_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBusiness"
                        style="@style/Widget.Hesba.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:hint="@string/field_city">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCity"
                        style="@style/Widget.Hesba.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_4"
                    android:text="@string/section_activity"
                    android:textAppearance="@style/TextAppearance.Hesba.Label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/activity_home" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSolo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/activity_solo" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStaff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/activity_staff" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Charges (travail d'Aya, sans valeurs inventées) -->
                <TextView
                    style="@style/Hesba.Section"
                    android:text="@string/section_charges" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/charges_note"
                    android:textAppearance="@style/TextAppearance.Hesba.Caption" />

                <LinearLayout
                    android:id="@+id/blockRent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:layout_marginEnd="@dimen/sp_2"
                        android:layout_weight="1"
                        android:hint="@string/field_rent"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRent"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:layout_marginStart="@dimen/sp_2"
                        android:layout_weight="1"
                        android:hint="@string/field_volume">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editVolume"
                            style="@style/Widget.Hesba.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:inputType="number"
                            android:maxLength="7" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmployees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:hint="@string/field_employees">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEmployees"
                        style="@style/Widget.Hesba.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSalary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:layout_marginEnd="@dimen/sp_2"
                        android:layout_weight="1"
                        android:hint="@string/field_salary"
                        app:suffixText="@string/currency_short">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSalary"
                            style="@style/Widget.Hesba.EditText.Money"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_3"
                        android:layout_marginStart="@dimen/sp_2"
                        android:layout_weight="1"
                        android:hint="@string/field_hours">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editHours"
                            style="@style/Widget.Hesba.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:inputType="number"
                            android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtChargesPreview"
                    style="@style/Hesba.Note"
                    android:layout_marginTop="@dimen/sp_3"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Hesba.Caption"
                    android:textColor="@color/hb_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_4"
                    android:text="@string/action_save_profile" />
            </LinearLayout>

            <!-- Préférences -->
            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_preferences" />

            <View style="@style/Hesba.Divider" />

            <include
                android:id="@+id/rowLanguage"
                layout="@layout/item_link" />

            <include
                android:id="@+id/rowTheme"
                layout="@layout/item_link" />

            <!-- Données -->
            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_data" />

            <View style="@style/Hesba.Divider" />

            <include
                android:id="@+id/rowBackup"
                layout="@layout/item_link" />

            <include
                android:id="@+id/rowRestore"
                layout="@layout/item_link" />

            <include
                android:id="@+id/rowInvoices"
                layout="@layout/item_link" />

            <include
                android:id="@+id/rowPassword"
                layout="@layout/item_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Hesba.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_5"
                android:text="@string/action_logout"
                app:icon="@drawable/ic_logout" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
