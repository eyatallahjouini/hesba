<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ton compte" android:textColor="@color/brun_clair" android:textSize="15sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon profil" android:textColor="@color/brun" android:textSize="32sp" android:textStyle="bold" android:fontFamily="serif"/>

      <!-- Carte du profil : remplie depuis la table utilisateur -->
      <LinearLayout android:id="@+id/cardProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/txtInitial" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_logo" android:gravity="center" android:text="?" android:textColor="@color/brun" android:textSize="26sp" android:textStyle="bold" android:fontFamily="serif"/>
          <TextView android:id="@+id/txtFirstName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Prénom" android:textColor="@color/brun" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Email" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        <TextView android:id="@+id/txtEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/brun" android:textSize="17sp" android:textStyle="bold"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/caramel"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Activité" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        <TextView android:id="@+id/txtActivity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/brun" android:textSize="17sp" android:textStyle="bold"/>
      </LinearLayout>

      <!-- Affiché seulement si la table utilisateur est vide -->
      <TextView android:id="@+id/txtNoProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="18dp" android:text="Aucun profil enregistré pour l'instant. Crée ton compte pour voir ton prénom, ton email et ton activité ici." android:textColor="@color/brun_clair" android:textSize="15sp" android:visibility="gone"/>
    </LinearLayout>
  </ScrollView>
  <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
