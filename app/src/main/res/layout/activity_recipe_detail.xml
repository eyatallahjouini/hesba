<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_6">

            <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginBottom="@dimen/sp_4"
                android:background="@drawable/bg_photo"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Hesba.Title" />

            <!-- Le chiffre principal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:text="@string/label_cost_per_portion"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <TextView
                android:id="@+id/txtCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hesba.Money.Large" />

            <TextView
                android:id="@+id/txtCostSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <!-- Le ticket : détail du coût, « imprimé » à l'ouverture -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/sp_5"
                android:background="@drawable/bg_printer_slot"
                android:importantForAccessibility="no" />

            <com.example.hesba.ui.widget.ReceiptLayout
                android:id="@+id/receipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_2"
                android:layout_marginEnd="@dimen/sp_2"
                android:paddingStart="@dimen/sp_4"
                android:paddingTop="@dimen/sp_4"
                android:paddingEnd="@dimen/sp_4"
                android:paddingBottom="@dimen/sp_4">

                <TextView
                    android:id="@+id/receiptTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Hesba.Ticket.Strong"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/receiptMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Hesba.Ticket.Soft" />

                <com.example.hesba.ui.widget.DotLeaderView
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/sp_3"
                    android:layout_marginBottom="@dimen/sp_1" />

                <LinearLayout
                    android:id="@+id/listDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.example.hesba.ui.widget.ReceiptLayout>

            <TextView
                android:id="@+id/txtIssues"
                style="@style/Hesba.Note"
                android:layout_marginTop="@dimen/sp_4"
                android:background="@drawable/bg_note_bad"
                android:visibility="gone" />

            <!-- Prix de vente pratiqué -->
            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_selling" />

            <View style="@style/Hesba.Divider" />

            <LinearLayout style="@style/Hesba.LedgerRow">
                <TextView
                    style="@style/Hesba.LedgerLabel"
                    android:text="@string/label_selling_price" />
                <TextView
                    android:id="@+id/txtPrice"
                    style="@style/Hesba.LedgerValue" />
            </LinearLayout>

            <LinearLayout style="@style/Hesba.LedgerRow">
                <TextView
                    style="@style/Hesba.LedgerLabel"
                    android:text="@string/label_real_margin" />
                <TextView
                    android:id="@+id/txtMargin"
                    style="@style/Hesba.LedgerValue" />
            </LinearLayout>

            <LinearLayout style="@style/Hesba.LedgerRow">
                <TextView
                    style="@style/Hesba.LedgerLabel"
                    android:text="@string/label_profit" />
                <TextView
                    android:id="@+id/txtProfit"
                    style="@style/Hesba.LedgerValue" />
            </LinearLayout>

            <LinearLayout style="@style/Hesba.LedgerRow">
                <TextView
                    android:id="@+id/lblSuggested"
                    style="@style/Hesba.LedgerLabel" />
                <TextView
                    android:id="@+id/txtSuggested"
                    style="@style/Hesba.LedgerValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPrice"
                    style="@style/Widget.Hesba.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_change_price" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplySuggested"
                    style="@style/Widget.Hesba.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Conseiller de marge -->
            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_advisor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advisor_intro"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:background="@drawable/bg_advisor"
                android:orientation="vertical"
                android:padding="@dimen/sp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/advisor_margin"
                        android:textAppearance="@style/TextAppearance.Hesba.Body.Soft" />

                    <TextView
                        android:id="@+id/txtAdvisorMargin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Hesba.Money" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMargin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/advisor_margin"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="90"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:thumbColor="@color/hb_accent_ink"
                    app:trackColorActive="@color/hb_accent"
                    app:trackColorInactive="@color/hb_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:text="@string/advisor_price"
                    android:textAppearance="@style/TextAppearance.Hesba.Body.Soft" />

                <LinearLayout
                    android:id="@+id/advisorPriceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom|end"
                    android:orientation="horizontal">

                    <com.example.hesba.ui.widget.RollingNumberView
                        android:id="@+id/txtAdvisorPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Hesba.Money.Large" />

                    <TextView
                        android:id="@+id/txtAdvisorCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="6dp"
                        android:importantForAccessibility="no"
                        android:text="@string/currency_short"
                        android:textAppearance="@style/TextAppearance.Hesba.Ticket.Soft"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout style="@style/Hesba.LedgerRow">
                    <TextView
                        style="@style/Hesba.LedgerLabel"
                        android:text="@string/advisor_profit" />
                    <TextView
                        android:id="@+id/txtAdvisorProfit"
                        style="@style/Hesba.LedgerValue" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAdvisorEffect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_2"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Hesba.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeepMargin"
                    style="@style/Widget.Hesba.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTopIngredient"
                style="@style/Hesba.Note"
                android:layout_marginTop="@dimen/sp_3"
                android:visibility="gone" />

            <!-- Actions -->
            <TextView
                style="@style/Hesba.Section"
                android:text="@string/section_actions" />

            <View style="@style/Hesba.Divider" />

            <include
                android:id="@+id/actShopping"
                layout="@layout/item_link" />

            <include
                android:id="@+id/actDuplicate"
                layout="@layout/item_link" />

            <include
                android:id="@+id/actPdf"
                layout="@layout/item_link" />

            <include
                android:id="@+id/actEdit"
                layout="@layout/item_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Hesba.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:text="@string/action_delete_recipe"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
