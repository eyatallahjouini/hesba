<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnBack" android:layout_width="44dp" android:text="‹" android:textColor="@color/brun" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:layout_height="44dp" android:background="@drawable/bg_back" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
          <TextView android:id="@+id/txtRecipeName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gâteau au chocolat" android:textColor="@color/brun" android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif"/>
          <TextView android:id="@+id/txtRecipeInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 parts · four 1 h" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginTop="18dp" android:weightSum="3">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coût par part" android:textColor="@color/brun_clair" android:textSize="13sp"/>
          <TextView android:id="@+id/txtCostPerPart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,87 dt" android:textColor="@color/brun" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_highlight" android:padding="12dp" android:gravity="center">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prix conseillé" android:textColor="@color/brun" android:textSize="13sp"/>
          <TextView android:id="@+id/txtAdvisedPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3,11 dt" android:textColor="@color/brun" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bénéfice" android:textColor="@color/brun_clair" android:textSize="13sp"/>
          <TextView android:id="@+id/txtProfitPerPart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,24 dt" android:textColor="@color/vert" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Où va l'argent ?" android:textColor="@color/brun" android:textSize="18sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="14dp" android:orientation="horizontal" android:weightSum="2242">
          <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="982" android:background="@color/brun"/>
          <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="600" android:background="@color/safran"/>
          <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="360" android:background="@color/marron_barre"/>
          <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="240" android:background="@color/caramel"/>
          <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="60" android:background="@color/jaune_energie"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="●" android:textColor="@color/brun" android:textSize="16sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Matières premières" android:textColor="@color/brun" android:textSize="15sp"/>
          <TextView android:id="@+id/txtRawMaterials" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9,82 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="●" android:textColor="@color/safran" android:textSize="16sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Main-d'œuvre" android:textColor="@color/brun" android:textSize="15sp"/>
          <TextView android:id="@+id/txtLabor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6,00 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="●" android:textColor="@color/marron_barre" android:textSize="16sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Charges fixes" android:textColor="@color/brun" android:textSize="15sp"/>
          <TextView android:id="@+id/txtFixedCosts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3,60 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="●" android:textColor="@color/caramel" android:textSize="16sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Emballage" android:textColor="@color/brun" android:textSize="15sp"/>
          <TextView android:id="@+id/txtPackaging" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2,40 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="●" android:textColor="@color/jaune_energie" android:textSize="16sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Énergie" android:textColor="@color/brun" android:textSize="15sp"/>
          <TextView android:id="@+id/txtEnergy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,60 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/caramel"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total du lot" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
          <TextView android:id="@+id/txtTotalBatch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22,42 dt" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Marge voulue" android:textColor="@color/brun" android:textSize="18sp" android:textStyle="bold"/>
          <TextView android:id="@+id/txtMarginValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40 %" android:textColor="@color/brun" android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekMargin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:max="100" android:progress="40" android:progressTint="@color/safran" android:thumbTint="@color/safran"/>
      </LinearLayout>
      <Button android:id="@+id/btnSaveRecipe" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="Enregistrer la recette" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/brun" android:backgroundTint="@color/safran" app:cornerRadius="16dp"/>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/white" android:elevation="8dp">
    <LinearLayout android:id="@+id/navBilan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_bilan" android:contentDescription="Bilan" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Bilan" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navRecettes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_nav_active">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_recettes" android:contentDescription="Recettes" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Recettes" android:textColor="@color/brun" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navIngredients" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_ingredients" android:contentDescription="Ingrédients" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Ingrédients" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navVentes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_ventes" android:contentDescription="Ventes" app:tint="@color/brun"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Ventes" android:textColor="@color/brun" android:textSize="12sp"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
