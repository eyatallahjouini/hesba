<?xml version="1.0" encoding="utf-8"?>
<!-- Même structure que activity_mes_recettes (Aya) : compteur, titre, message vide, liste, bouton fixe en bas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <TextView android:id="@+id/txtRecipeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 recette enregistrée" android:textColor="@color/brun_clair" android:textSize="15sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mes recettes" android:textColor="@color/brun" android:textSize="32sp" android:textStyle="bold" android:fontFamily="serif"/>
      <TextView android:id="@+id/txtNoRecipe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="18dp" android:text="Aucune recette pour l&apos;instant. Appuie sur « Nouvelle recette » pour calculer ton premier coût de revient." android:textColor="@color/brun_clair" android:textSize="15sp" android:visibility="gone"/>
      <LinearLayout android:id="@+id/listRecipes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
  </ScrollView>
  <Button android:id="@+id/btnNewRecipe" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="+ Nouvelle recette" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/brun" android:backgroundTint="@color/safran" app:cornerRadius="16dp"/>
  <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
