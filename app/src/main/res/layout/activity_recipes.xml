<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête fixe : titre, recherche, tri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_5"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/tab_recipes"
                    android:textAppearance="@style/TextAppearance.Hesba.Display" />

                <TextView
                    android:id="@+id/txtCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Hesba.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch"
                android:text="@string/action_new"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

        <include
            android:id="@+id/search"
            layout="@layout/view_search" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/sortName"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/sortName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/sort_name" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sortCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/sort_cost" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sortMargin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/sort_margin" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- en-tête de colonnes, aligné sur les montants des lignes -->
        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_2"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/sp_1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/col_recipe"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/col_cost_portion"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />
        </LinearLayout>

        <View style="@style/Hesba.Divider" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_5" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
