<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/creme" android:orientation="vertical">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnBack" android:layout_width="44dp" android:text="‹" android:textColor="@color/brun" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:layout_height="44dp" android:background="@drawable/bg_back" android:clickable="true" android:focusable="true"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Créer ton compte" android:textColor="@color/brun" android:textSize="30sp" android:textStyle="bold" android:fontFamily="serif"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Ton atelier, tes recettes, tes prix : tout au même endroit." android:textColor="@color/brun_clair" android:textSize="15sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Prénom" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <EditText android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="textPersonName" android:maxLines="1" android:hint="Ton prénom"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Email" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <EditText android:id="@+id/editEmail" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="textEmailAddress" android:maxLines="1" android:hint="nom@exemple.com"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mot de passe" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <EditText android:id="@+id/editPassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/brun" android:textColorHint="@color/gris_hint" android:textSize="16sp" android:inputType="textPassword" android:maxLines="1" android:hint="Ton mot de passe"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="8 caractères minimum" android:textColor="@color/brun_clair" android:textSize="13sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Ton activité" android:textColor="@color/brun" android:textSize="14sp" android:textStyle="bold"/>
      <RadioGroup android:id="@+id/rgActivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
        <RadioButton android:id="@+id/rbHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="0dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:checked="true" android:text="À domicile"/>
        <RadioButton android:id="@+id/rbLocalSolo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="0dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:text="Local sans employé"/>
        <RadioButton android:id="@+id/rbLocalStaff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginEnd="0dp" android:button="@null" android:background="@drawable/bg_chip" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/brun" android:textSize="15sp" android:textStyle="bold" android:text="Local avec employés"/>
      </RadioGroup>
      <CheckBox android:id="@+id/checkPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:buttonTint="@color/safran" android:textColor="@color/brun" android:text="J'accepte la politique de confidentialité"/>
      <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Créer mon compte" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/brun" android:backgroundTint="@color/safran" app:cornerRadius="16dp"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
