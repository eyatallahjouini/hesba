<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <!-- Lecture en cours -->
    <LinearLayout
        android:id="@+id/blockLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/sp_6">

        <!-- la facture en cours de lecture, avec la ligne de lecture (réelle : elle s'arrête avec l'OCR) -->
        <FrameLayout
            android:id="@+id/scanStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgScanning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <com.example.hesba.ui.widget.ScanLineView
                android:id="@+id/scanLine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />
        </FrameLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_4"
            android:indeterminate="true"
            app:indicatorColor="@color/hb_accent_ink" />

        <TextView
            android:id="@+id/txtLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_4"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/review_reading"
            android:textAppearance="@style/TextAppearance.Hesba.Body" />
    </LinearLayout>

    <!-- Échec de lecture -->
    <include
        android:id="@+id/error"
        layout="@layout/view_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Vérification -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgThumb"
                    android:layout_width="64dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_photo"
                    android:contentDescription="@string/cd_invoice_image"
                    android:foreground="?attr/selectableItemBackground"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sp_4"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Hesba.Body" />
            </LinearLayout>

            <TextView
                style="@style/Hesba.Note"
                android:layout_marginTop="@dimen/sp_4"
                android:text="@string/review_legend" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSupplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:hint="@string/field_supplier">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSupplier"
                    style="@style/Widget.Hesba.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:hint="@string/field_invoice_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDate"
                    style="@style/Widget.Hesba.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/checkTax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/checkDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLinesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Hesba.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptAll"
                    style="@style/Widget.Hesba.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review_accept_all" />
            </LinearLayout>

            <View style="@style/Hesba.Divider" />

            <LinearLayout
                android:id="@+id/listLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRawText"
                style="@style/Widget.Hesba.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:text="@string/review_raw_text" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Résultat après confirmation -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_5">

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Hesba.Title" />

            <TextView
                android:id="@+id/txtResultBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:textAppearance="@style/TextAppearance.Hesba.Body.Soft" />

            <TextView
                android:id="@+id/txtResultAlert"
                style="@style/Hesba.Note"
                android:layout_marginTop="@dimen/sp_4"
                android:background="@drawable/bg_note_bad"
                android:visibility="gone" />

            <TextView
                style="@style/Hesba.Section"
                android:text="@string/result_recipes" />

            <View style="@style/Hesba.Divider" />

            <LinearLayout
                android:id="@+id/listImpacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtNoImpact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/sp_3"
                android:text="@string/result_no_recipe"
                android:textAppearance="@style/TextAppearance.Hesba.Body.Soft"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View style="@style/Hesba.Divider" />

        <TextView
            android:id="@+id/txtFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/sp_2"
            android:layout_marginEnd="@dimen/gutter"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Hesba.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="@dimen/sp_2"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_marginBottom="@dimen/sp_3" />
    </LinearLayout>
</LinearLayout>
