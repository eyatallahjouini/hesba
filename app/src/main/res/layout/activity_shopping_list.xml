<?xml version="1.0" encoding="utf-8"?>
<!-- Liste de courses (design Minimal) : barre ardoise avec retour ; carte de choix de la recette et des quantités ;
     carte « À acheter » (lignes séparées par un filet fin, totaux) ; seul bouton principal « Partager » collé en bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== Carte : recette et quantité ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecipe"
                        style="@style/Hesba.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="@string/shopping_choose"
                        app:icon="@drawable/ic_recipes" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- quantité + liste : visibles une fois la recette choisie -->
            <LinearLayout
                android:id="@+id/blockQty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPortions"
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/shopping_portions">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editPortions"
                                style="@style/Widget.Hesba.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:inputType="number"
                                android:maxLength="6" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/groupBatches"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            app:singleLine="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardToBuy"
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/shopping_to_buy"
                            android:textAppearance="@style/Hesba.Text.Title" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="horizontal"
                            android:paddingBottom="@dimen/space_xs">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/col_ingredient"
                                android:textAppearance="@style/Hesba.Text.Caption" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/col_estimated_cost"
                                android:textAppearance="@style/Hesba.Text.Caption" />
                        </LinearLayout>

                        <View style="@style/Hesba.Divider" />

                        <LinearLayout
                            android:id="@+id/listItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_hairline"
                            android:orientation="vertical"
                            android:showDividers="middle" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@color/hesba_border_strong" />

                        <LinearLayout style="@style/Hesba.LedgerRow">
                            <TextView
                                style="@style/Hesba.LedgerLabel"
                                android:text="@string/shopping_total_used"
                                android:textColor="@color/hesba_text_primary" />
                            <TextView
                                android:id="@+id/txtTotal"
                                style="@style/Hesba.LedgerValue"
                                android:textAppearance="@style/Hesba.Text.Amount.Accent"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout style="@style/Hesba.LedgerRow">
                            <TextView
                                style="@style/Hesba.LedgerLabel"
                                android:text="@string/shopping_total_packages" />
                            <TextView
                                android:id="@+id/txtTotalPackages"
                                style="@style/Hesba.LedgerValue" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txtMissing"
                    style="@style/Hesba.Note"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_note_bad"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/shopping_note"
                    android:textAppearance="@style/Hesba.Text.Caption" />
            </LinearLayout>

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- seul bouton principal de l'écran, collé en bas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_bar"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/action_share_list"
            app:icon="@drawable/ic_share" />
    </FrameLayout>
</LinearLayout>
