<?xml version="1.0" encoding="utf-8"?>
<!-- « Et si… » (design Minimal) : barre ardoise avec retour ; carte de choix de l'ingrédient ;
     carte du changement de prix ; carte des recettes touchées ; seul bouton principal « Appliquer » collé en bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hesba_background"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== Carte : l'ingrédient ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Hesba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/whatif_intro"
                        android:textAppearance="@style/Hesba.Text.Body"
                        android:textColor="@color/hesba_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngredient"
                        style="@style/Hesba.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="start|center_vertical"
                        android:text="@string/whatif_choose"
                        app:icon="@drawable/ic_ingredients" />

                    <TextView
                        android:id="@+id/txtCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/Hesba.Text.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/blockChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ===== Carte : le changement ===== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/whatif_change"
                            android:textAppearance="@style/Hesba.Text.Title" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/groupMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            app:checkedChip="@id/modePercent"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/modePercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/whatif_mode_percent" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/modeAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/whatif_mode_amount" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/modePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/whatif_mode_price" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilValue"
                            style="@style/Hesba.Field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editValue"
                                style="@style/Widget.Hesba.EditText.Money"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="-0123456789.,٠١٢٣٤٥٦٧٨٩٫"
                                android:inputType="numberSigned|numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/txtNewPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:accessibilityLiveRegion="polite"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/Hesba.Text.Title" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Carte : recettes touchées ===== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Hesba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    app:contentPaddingBottom="@dimen/space_xs">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtImpactTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/Hesba.Text.Title" />

                        <LinearLayout
                            android:id="@+id/listImpacts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/txtNoImpact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/space_m"
                            android:paddingBottom="@dimen/space_m"
                            android:text="@string/whatif_no_recipe"
                            android:textAppearance="@style/Hesba.Text.Body"
                            android:textColor="@color/hesba_text_secondary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Hesba.Note"
                    android:layout_marginTop="@dimen/card_gap"
                    android:text="@string/whatif_nothing_saved" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- seul bouton principal de l'écran, collé en bas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_bar"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Hesba.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/whatif_apply" />
    </FrameLayout>
</LinearLayout>
