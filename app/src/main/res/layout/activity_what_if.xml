<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/sp_5">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/whatif_intro"
                android:textAppearance="@style/TextAppearance.Hesba.Body.Soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngredient"
                style="@style/Widget.Hesba.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:gravity="start|center_vertical"
                android:text="@string/whatif_choose"
                app:icon="@drawable/ic_ingredients" />

            <TextView
                android:id="@+id/txtCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <LinearLayout
                android:id="@+id/blockChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Hesba.Section"
                    android:text="@string/whatif_change" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedChip="@id/modePercent"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/whatif_mode_percent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/whatif_mode_amount" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/whatif_mode_price" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editValue"
                        style="@style/Widget.Hesba.EditText.Money"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="-0123456789.,٠١٢٣٤٥٦٧٨٩٫"
                        android:inputType="numberSigned|numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/txtNewPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_3"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Hesba.Subtitle" />

                <TextView
                    android:id="@+id/txtImpactTitle"
                    style="@style/Hesba.Section" />

                <View style="@style/Hesba.Divider" />

                <LinearLayout
                    android:id="@+id/listImpacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtNoImpact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/sp_3"
                    android:text="@string/whatif_no_recipe"
                    android:textAppearance="@style/TextAppearance.Hesba.Body.Soft"
                    android:visibility="gone" />

                <TextView
                    style="@style/Hesba.Note"
                    android:layout_marginTop="@dimen/sp_4"
                    android:text="@string/whatif_nothing_saved" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View style="@style/Hesba.Divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/sp_3"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/sp_3"
        android:enabled="false"
        android:text="@string/whatif_apply" />
</LinearLayout>
