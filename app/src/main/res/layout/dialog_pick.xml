<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_5"
    android:paddingEnd="@dimen/sp_5">

    <include
        android:id="@+id/search"
        layout="@layout/view_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        style="@style/Widget.Hesba.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:visibility="gone"
        app:icon="@drawable/ic_add"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/sp_1" />

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/sp_3"
        android:paddingBottom="@dimen/sp_3"
        android:textAppearance="@style/TextAppearance.Hesba.Body.Soft"
        android:visibility="gone" />
</LinearLayout>
