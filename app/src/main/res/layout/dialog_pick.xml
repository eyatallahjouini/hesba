<?xml version="1.0" encoding="utf-8"?>
<!-- Liste de choix dans un dialogue (design Minimal) : recherche, « Créer… », liste filtrable -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl">

    <include
        android:id="@+id/search"
        layout="@layout/view_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        style="@style/Hesba.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone"
        app:icon="@drawable/ic_add"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/space_xs" />

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m"
        android:textAppearance="@style/Hesba.Text.Body"
        android:textColor="@color/hesba_text_secondary"
        android:visibility="gone" />
</LinearLayout>
