<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sp_5"
        android:paddingTop="@dimen/sp_2"
        android:paddingEnd="@dimen/sp_5">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_read_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editName"
                style="@style/Widget.Hesba.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textDirection="anyRtl" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:layout_marginEnd="@dimen/sp_2"
                android:layout_weight="1"
                android:hint="@string/field_quantity">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editQty"
                    style="@style/Widget.Hesba.EditText.Money"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUnitPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_3"
                android:layout_marginStart="@dimen/sp_2"
                android:layout_weight="1"
                android:hint="@string/field_unit_price"
                app:suffixText="@string/currency_short">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUnitPrice"
                    style="@style/Widget.Hesba.EditText.Money"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_4"
            android:text="@string/scanline_price_for"
            android:textAppearance="@style/TextAppearance.Hesba.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_3"
            android:hint="@string/field_package_content"
            app:helperText="@string/helper_package_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPackage"
                style="@style/Widget.Hesba.EditText.Money"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupPackageUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />
    </LinearLayout>
</ScrollView>
