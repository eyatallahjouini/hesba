<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne de détail (design Minimal, partagée) : libellé au début, détail (quantité) dessous, montant à la fin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ledgerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Body" />

        <TextView
            android:id="@+id/ledgerDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/Hesba.Text.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/ledgerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.Hesba.Money.Small" />
</LinearLayout>
