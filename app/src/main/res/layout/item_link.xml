<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne de lien (design Minimal, partagée) : icône, titre, sous-titre, chevron (miroir en arabe), filet en bas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowClick"
        style="@style/Hesba.Row"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/icon"
            android:layout_height="@dimen/icon"
            android:layout_marginEnd="@dimen/space_l"
            android:importantForAccessibility="no"
            app:tint="@color/hesba_accent_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Hesba.Text.Body" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/Hesba.Text.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.Hesba.Money.Small"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron"
            app:tint="@color/hesba_text_hint" />
    </LinearLayout>

    <View style="@style/Hesba.Divider" />
</LinearLayout>
