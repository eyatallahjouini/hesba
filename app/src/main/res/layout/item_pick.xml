<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch"
    android:orientation="vertical"
    android:paddingTop="@dimen/sp_3"
    android:paddingBottom="@dimen/sp_3">

    <TextView
        android:id="@+id/pickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Hesba.Label" />

    <TextView
        android:id="@+id/pickSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.Hesba.Caption" />
</LinearLayout>
