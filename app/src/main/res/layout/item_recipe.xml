<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/cardRecipe" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/imgRecipePhoto" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nom de la recette" android:textColor="@color/brun" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtServings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 parts" android:textColor="@color/brun_clair" android:textSize="14sp"/>
      </LinearLayout>
      <TextView android:id="@+id/txtMargin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▲ Marge 40 %" android:textColor="@color/vert" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_badge_green" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="bottom">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="28dp">
        <TextView android:id="@+id/txtCostLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coût par part" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        <TextView android:id="@+id/txtCost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,00 dt" android:textColor="@color/brun" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prix de vente" android:textColor="@color/brun_clair" android:textSize="14sp"/>
        <TextView android:id="@+id/txtPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,00 dt" android:textColor="@color/brun" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
      </LinearLayout>
      <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      <!-- mini boutons d'action, comme dans la page Ingrédients -->
      <ImageButton android:id="@+id/btnEditRecipe" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/caramel_clair" android:src="@drawable/ic_action_edit" android:scaleType="fitCenter" android:padding="9dp" app:tint="@color/safran_texte" android:contentDescription="Modifier la recette"/>
      <ImageButton android:id="@+id/btnDeleteRecipe" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_circle" android:backgroundTint="@color/rouge_clair" android:src="@drawable/ic_action_delete" android:scaleType="fitCenter" android:padding="9dp" app:tint="@color/rouge" android:contentDescription="Supprimer la recette"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
