<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne de facture à vérifier : texte lu, ingrédient associé, ancien → nouveau prix, actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/lineRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/sp_3"
        android:paddingBottom="@dimen/sp_3">

        <TextView
            android:id="@+id/txtRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Hesba.Caption"
            android:textDirection="anyRtl" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMatch"
                style="@style/Widget.Hesba.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:minHeight="@dimen/touch"
                app:icon="@drawable/ic_ingredients" />

            <TextView
                android:id="@+id/tagMatch"
                style="@style/Hesba.Tag"
                android:layout_marginStart="@dimen/sp_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_2"
            android:fontFeatureSettings="tnum"
            android:padding="@dimen/sp_1"
            android:textAppearance="@style/TextAppearance.Hesba.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_1"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPriceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Hesba.Caption" />

            <TextView
                android:id="@+id/txtPrices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/sp_1"
                android:textAppearance="@style/TextAppearance.Hesba.Money.Small" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDelta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Hesba.Caption" />

        <TextView
            android:id="@+id/txtProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_1"
            android:textAppearance="@style/TextAppearance.Hesba.Caption"
            android:textColor="@color/hb_bad"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    style="@style/Widget.Hesba.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch"
                    android:text="@string/review_accept"
                    app:icon="@drawable/ic_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIgnore"
                    style="@style/Widget.Hesba.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch"
                    android:text="@string/review_ignore" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Hesba.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/review_edit"
                app:icon="@drawable/ic_edit" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Hesba.Divider" />
</LinearLayout>
