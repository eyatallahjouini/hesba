<?xml version="1.0" encoding="utf-8"?>
<!-- Étape du premier usage : numéro (ou coche), texte, bouton -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stepRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/sp_4"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/stepNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_monogram"
        android:fontFamily="@font/hb_sans_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/hb_ink"
        android:textSize="16sp"
        android:textStyle="normal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Hesba.Label" />

        <TextView
            android:id="@+id/stepBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Hesba.Caption" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stepButton"
        style="@style/Widget.Hesba.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_2"
        android:minHeight="@dimen/touch"
        android:paddingStart="@dimen/sp_4"
        android:paddingEnd="@dimen/sp_4" />
</LinearLayout>
