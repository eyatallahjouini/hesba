<?xml version="1.0" encoding="utf-8"?>
<!-- État vide : icône discrète, titre, explication, une action claire -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_6"
    android:paddingTop="@dimen/sp_7"
    android:paddingEnd="@dimen/sp_6">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        app:tint="@color/hb_accent_ink" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_4"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Hesba.Title" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_2"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Hesba.Body.Soft" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_5"
        android:paddingStart="@dimen/sp_5"
        android:paddingEnd="@dimen/sp_5" />
</LinearLayout>
