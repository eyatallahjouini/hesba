<?xml version="1.0" encoding="utf-8"?>
<!-- État vide (design Minimal, partagé par les listes) : icône grise dans un cercle, titre, phrase, une action claire -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_xxl"
    android:paddingEnd="@dimen/space_xxl">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_empty_icon">

        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/hesba_text_hint" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/Hesba.Text.Title" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textAppearance="@style/Hesba.Text.Body"
        android:textColor="@color/hesba_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        style="@style/Hesba.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl" />
</LinearLayout>
