<?xml version="1.0" encoding="utf-8"?>
<!-- Champ de recherche fixe en haut des listes : loupe, saisie, effacer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="@dimen/sp_4"
    android:background="@drawable/bg_search"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/sp_3">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        app:tint="@color/hb_ink_soft" />

    <EditText
        android:id="@+id/editSearch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sp_3"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/hb_ink"
        android:textColorHint="@color/hb_hint"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClear"
        style="@style/Widget.Hesba.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_clear_search"
        android:visibility="gone"
        app:icon="@drawable/ic_close"
        app:iconSize="18dp" />
</LinearLayout>
