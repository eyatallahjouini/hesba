<?xml version="1.0" encoding="utf-8"?>
<!-- Barre du haut « Minimal » des écrans refaits : fond ardoise, retour et titre blancs, action facultative.
     ID lus par BaseActivity : btnBack (retour), txtTitle (setTitleText), btnAction (facultatif). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height"
    android:background="@color/hesba_primary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Hesba.Toolbar.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_back"
        app:icon="@drawable/ic_back" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Hesba.Text.Toolbar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        style="@style/Hesba.Toolbar.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
