<?xml version="1.0" encoding="utf-8"?>
<!-- Anciens rôles « hb_* » encore utilisés par les layouts et le Kotlin : ils pointent maintenant
     vers la palette Minimal (colors.xml / values-night/colors.xml), donc clair et sombre suivent tout seuls.
     À mesure que les écrans sont refaits, les layouts passent aux noms hesba_*. -->
<resources>
    <color name="hb_bg">@color/hesba_background</color>
    <color name="hb_surface">@color/hesba_surface</color>
    <color name="hb_surface_alt">@color/hesba_surface_alt</color>
    <color name="hb_paper">@color/hesba_surface</color>
    <color name="hb_ink">@color/hesba_text_primary</color>
    <color name="hb_ink_soft">@color/hesba_text_secondary</color>
    <color name="hb_hint">@color/hesba_text_hint</color>
    <color name="hb_line">@color/hesba_border</color>
    <color name="hb_line_strong">@color/hesba_border_strong</color>
    <color name="hb_accent">@color/hesba_accent</color>
    <color name="hb_on_accent">@color/hesba_on_accent</color>
    <color name="hb_accent_ink">@color/hesba_accent_text</color>
    <color name="hb_accent_soft">@color/hesba_accent_soft</color>
    <color name="hb_good">@color/hesba_success</color>
    <color name="hb_good_bg">@color/hesba_success_bg</color>
    <color name="hb_bad">@color/hesba_error</color>
    <color name="hb_bad_bg">@color/hesba_error_bg</color>
    <!-- ancienne « ardoise » de la liste des ingrédients : ardoise Minimal, dans les deux thèmes -->
    <color name="hb_slate">#1F2933</color>
    <color name="hb_slate_line">#3A4754</color>
    <color name="hb_chalk">#F1F3F5</color>
    <color name="hb_chalk_soft">#9AA3AD</color>
    <color name="hb_chalk_accent">@color/hesba_accent</color>
    <color name="hb_chalk_bad">#F28B9C</color>
    <color name="hb_scrim">@color/hesba_scrim</color>
</resources>
