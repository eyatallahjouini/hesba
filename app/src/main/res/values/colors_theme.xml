<?xml version="1.0" encoding="utf-8"?>
<!-- Rôles de couleur HESBA « Le Ticket » (mode clair).
     Même famille que la palette d'origine (safran, brun, crème, caramel, vert, rouge), adoucie pour les yeux :
     fond papier chaud au lieu d'un blanc éclatant, encre brune profonde, safran réservé à l'action.
     Contrastes (WCAG) sur hb_bg : encre 14:1, encre douce 6,4:1, safran texte 5,2:1, indice 4,1:1. -->
<resources>
    <color name="hb_bg">#F6F0E6</color>
    <color name="hb_surface">#FFFBF4</color>
    <color name="hb_surface_alt">#EFE3CF</color>
    <!-- papier du ticket (fiche recette, scanner, premier lancement) -->
    <color name="hb_paper">#FFFDF8</color>
    <color name="hb_ink">#2D1F1A</color>
    <color name="hb_ink_soft">#6A564C</color>
    <color name="hb_hint">#8B776C</color>
    <color name="hb_line">#E3D5C1</color>
    <color name="hb_line_strong">#CBB79C</color>
    <color name="hb_accent">#F28C28</color>
    <color name="hb_on_accent">#2D1F1A</color>
    <color name="hb_accent_ink">#A0520A</color>
    <color name="hb_accent_soft">#FBE5CA</color>
    <color name="hb_good">#2E7D32</color>
    <color name="hb_good_bg">#E3EFDF</color>
    <color name="hb_bad">#C62828</color>
    <color name="hb_bad_bg">#F9E1DE</color>
    <!-- ardoise du marché (liste des ingrédients) : craie sur ardoise, dans les deux thèmes -->
    <color name="hb_slate">#27302B</color>
    <color name="hb_slate_line">#4A5650</color>
    <color name="hb_chalk">#F2EDE2</color>
    <color name="hb_chalk_soft">#B4B8AE</color>
    <color name="hb_chalk_accent">#F7A94F</color>
    <color name="hb_chalk_bad">#F4A097</color>
    <color name="hb_scrim">#993E2723</color>
</resources>
