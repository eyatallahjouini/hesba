<?xml version="1.0" encoding="utf-8"?>
<!-- Composants HESBA. Peu d'arrondis (10 dp), pas de dégradés, pas d'ombres décoratives :
     la hiérarchie vient de la typographie, des filets et de l'alignement. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- parents implicites des styles « Hesba.* » et « TextAppearance.Hesba.* » -->
    <style name="Hesba" />
    <style name="TextAppearance.Hesba" parent="TextAppearance.Material3.BodyLarge" />

    <!-- Texte par défaut : Plex Sans Arabic, couleur encre (une textAppearance posée sur la vue passe devant) -->
    <style name="Widget.Hesba.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Body</item>
    </style>
    <style name="Widget.Hesba.EditTextBase" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/hb_sans</item>
        <item name="fontFamily">@font/hb_sans</item>
    </style>

    <!-- Boutons : les anciens noms (utilisés par le thème et les écrans pas encore refaits)
         héritent maintenant des styles Minimal plus bas (Hesba.Button.*) -->
    <style name="Widget.Hesba.Button" parent="Hesba.Button.Primary" />
    <style name="Widget.Hesba.Button.Outlined" parent="Hesba.Button.Secondary" />
    <style name="Widget.Hesba.Button.Text" parent="Hesba.Button.Text" />
    <style name="Widget.Hesba.Button.Danger" parent="Hesba.Button.Danger" />
    <!-- bouton-icône 48 dp (barre du haut, actions de ligne) -->
    <style name="Widget.Hesba.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/hb_ink</item>
        <item name="iconSize">22dp</item>
        <item name="android:minWidth">@dimen/touch</item>
        <item name="android:minHeight">@dimen/touch</item>
    </style>

    <!-- Bouton d'ajout signature : carré aux coins légèrement arrondis, fixé en bas à la fin (bas-gauche en arabe).
         Il s'ouvre en formulaire par une transformation de conteneur (ui/Transitions.kt). -->
    <style name="Widget.Hesba.AddSquare" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/add_square</item>
        <item name="android:layout_height">@dimen/add_square</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_marginEnd">@dimen/gutter</item>
        <item name="android:layout_marginBottom">@dimen/sp_5</item>
        <item name="android:minWidth">@dimen/add_square</item>
        <item name="android:minHeight">@dimen/add_square</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/hb_on_accent</item>
        <item name="backgroundTint">@color/hb_button_bg</item>
        <item name="rippleColor">@color/hesba_ripple</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- design Minimal : plat, pas d'ombre forte -->
        <item name="android:elevation">0dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/hb_ink</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/hb_ink</item>
    </style>

    <!-- Champs : anciens noms → styles Minimal (Hesba.Field*) -->
    <style name="Widget.Hesba.TextInput" parent="Hesba.Field" />
    <style name="Widget.Hesba.TextInput.Dropdown" parent="Hesba.Field.Dropdown" />
    <style name="Widget.Hesba.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/hb_sans</item>
        <item name="fontFamily">@font/hb_sans</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:textSize">16sp</item>
    </style>
    <!-- montant : chiffres tabulaires ; accepte , . et les chiffres arabes -->
    <style name="Widget.Hesba.EditText.Money">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:digits">0123456789.,٠١٢٣٤٥٦٧٨٩٫</item>
        <item name="android:maxLength">12</item>
    </style>

    <!-- Puces de tri / de choix -->
    <style name="Widget.Hesba.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/hb_chip_bg</item>
        <item name="android:textColor">@color/hb_chip_text</item>
        <item name="chipStrokeColor">@color/hb_ink</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/radius_s</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Label</item>
        <item name="chipMinTouchTargetSize">@dimen/touch</item>
    </style>

    <!-- Mise en page -->
    <style name="Hesba.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/hb_line</item>
    </style>
    <style name="Hesba.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sp_5</item>
        <item name="android:layout_marginBottom">@dimen/sp_2</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Section</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>
    <!-- ligne de liste cliquable : 64 dp minimum -->
    <style name="Hesba.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_3</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <!-- ligne du « ticket » de coûts : libellé au début, montant à la fin -->
    <style name="Hesba.LedgerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:baselineAligned">true</item>
    </style>
    <style name="Hesba.LedgerLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Body.Soft</item>
    </style>
    <style name="Hesba.LedgerValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Money</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:layout_marginStart">@dimen/sp_3</item>
    </style>
    <!-- encadré d'information : filet safran au début, pas de carte -->
    <style name="Hesba.Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_note</item>
        <item name="android:paddingStart">@dimen/sp_4</item>
        <item name="android:paddingEnd">@dimen/sp_4</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_3</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Body</item>
    </style>
    <style name="Hesba.Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Caption</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Hesba.Tag.Bad">
        <item name="android:background">@drawable/bg_tag_bad</item>
        <item name="android:textColor">@color/hb_bad</item>
    </style>
    <style name="Hesba.Tag.Good">
        <item name="android:background">@drawable/bg_tag_good</item>
        <item name="android:textColor">@color/hb_good</item>
    </style>

    <!-- touche d'action rapide (Accueil) : icône au-dessus du libellé, 88 dp de haut -->
    <style name="Hesba.QuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_3</item>
        <item name="android:paddingStart">@dimen/sp_1</item>
        <item name="android:paddingEnd">@dimen/sp_1</item>
        <item name="android:drawablePadding">@dimen/sp_2</item>
        <item name="drawableTint">@color/hb_accent_ink</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Label</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <!-- chiffre clé : grand nombre serif + légende -->
    <style name="Hesba.Figure">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/sp_3</item>
        <item name="android:paddingEnd">@dimen/sp_2</item>
        <item name="android:paddingTop">@dimen/sp_1</item>
        <item name="android:paddingBottom">@dimen/sp_1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Dialogues -->
    <style name="ThemeOverlay.Hesba.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/hb_accent_ink</item>
        <item name="colorSurface">@color/hb_surface</item>
        <item name="colorSurfaceContainerHigh">@color/hb_surface</item>
        <item name="colorOnSurface">@color/hb_ink</item>
        <item name="colorOnSurfaceVariant">@color/hb_ink_soft</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Hesba.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Hesba.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Hesba.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Hesba.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Hesba.Button.Text</item>
    </style>
    <style name="ShapeAppearance.Hesba.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="Hesba.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/hb_sans_bold</item>
        <item name="fontFamily">@font/hb_sans_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/hesba_text_primary</item>
    </style>

    <style name="Widget.Hesba.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/hb_accent_ink</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:minHeight">@dimen/touch</item>
    </style>
    <style name="Widget.Hesba.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/hb_ink</item>
    </style>
    <style name="Widget.Hesba.SnackbarText" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/hb_bg</item>
    </style>
    <style name="Widget.Hesba.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/hb_accent</item>
    </style>

    <!-- ================================================================
         SYSTÈME « MINIMAL » : styles à utiliser dans les écrans refaits
         (le parent est toujours écrit, car le style vide « Hesba » existe déjà)
         ================================================================ -->

    <!-- Boutons -->
    <style name="Hesba.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/hb_button_bg</item>
        <item name="android:textColor">@color/hesba_on_accent_state</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/hesba_on_accent</item>
        <item name="iconPadding">@dimen/space_s</item>
        <item name="rippleColor">@color/hesba_ripple</item>
        <item name="elevation">0dp</item>
    </style>
    <!-- contour couleur texte fort : #1F2933 en clair, clair en sombre (sinon invisible sur fond sombre) -->
    <style name="Hesba.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/hb_outlined_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/hesba_text_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/hesba_text_primary</item>
        <item name="iconPadding">@dimen/space_s</item>
        <item name="rippleColor">@color/hesba_ripple</item>
    </style>
    <!-- lien texte turquoise (ex. « Créer un compte ») -->
    <style name="Hesba.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/hesba_accent_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="iconTint">@color/hesba_accent_text</item>
        <item name="rippleColor">@color/hesba_ripple</item>
    </style>
    <!-- action destructive en texte rouge (Supprimer, Se déconnecter) -->
    <style name="Hesba.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/hesba_error</item>
        <item name="android:textAppearance">@style/TextAppearance.Hesba.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="iconTint">@color/hesba_error</item>
        <item name="rippleColor">@color/hesba_error_bg</item>
    </style>

    <!-- Bouton flottant « + » : turquoise, icône foncée, ombre légère (2 dp) -->
    <style name="Hesba.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/hesba_accent</item>
        <item name="tint">@color/hesba_on_accent</item>
        <item name="srcCompat">@drawable/ic_add</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Hesba.Fab</item>
        <item name="elevation">2dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">2dp</item>
        <item name="rippleColor">@color/hesba_ripple</item>
    </style>
    <style name="ShapeAppearance.Hesba.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <!-- Carte plate : fond surface, coins 16 dp, filet 1 dp, aucune ombre, padding 16 dp -->
    <style name="Hesba.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/hesba_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="strokeColor">@color/hesba_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="rippleColor">@color/hesba_ripple</item>
    </style>

    <!-- Champs (TextInputLayout) : contour gris, turquoise au focus -->
    <style name="Hesba.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/hb_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
        <item name="boxBackgroundColor">@color/hesba_surface</item>
        <item name="hintTextColor">@color/hesba_accent_text</item>
        <item name="android:textColorHint">@color/hesba_text_secondary</item>
        <item name="placeholderTextColor">@color/hesba_text_hint</item>
        <item name="cursorColor">@color/hesba_accent</item>
        <item name="errorTextColor">@color/hesba_error</item>
        <item name="boxStrokeErrorColor">@color/hesba_error</item>
        <item name="errorIconTint">@color/hesba_error</item>
        <item name="helperTextTextColor">@color/hesba_text_secondary</item>
        <item name="suffixTextColor">@color/hesba_text_secondary</item>
        <item name="prefixTextColor">@color/hesba_text_secondary</item>
        <item name="startIconTint">@color/hesba_text_secondary</item>
        <item name="endIconTint">@color/hesba_text_secondary</item>
    </style>
    <!-- liste déroulante (exposed dropdown menu) -->
    <style name="Hesba.Field.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/hb_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
        <item name="boxBackgroundColor">@color/hesba_surface</item>
        <item name="hintTextColor">@color/hesba_accent_text</item>
        <item name="android:textColorHint">@color/hesba_text_secondary</item>
        <item name="cursorColor">@color/hesba_accent</item>
        <item name="startIconTint">@color/hesba_text_secondary</item>
        <item name="endIconTint">@color/hesba_text_secondary</item>
    </style>

    <!-- Textes : utilisables en style="" ou en android:textAppearance="" -->
    <style name="Hesba.Text.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/hb_sans_bold</item>
        <item name="fontFamily">@font/hb_sans_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/hesba_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Hesba.Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/hb_sans_medium</item>
        <item name="fontFamily">@font/hb_sans_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/hesba_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Hesba.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/hb_sans</item>
        <item name="fontFamily">@font/hb_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/hesba_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Hesba.Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/hb_sans</item>
        <item name="fontFamily">@font/hb_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hesba_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- montant : chiffres à chasse fixe (Plex Mono, Cairo en arabe) pour que les colonnes s'alignent -->
    <style name="Hesba.Text.Amount" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/hb_mono_semibold</item>
        <item name="fontFamily">@font/hb_mono_semibold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/hesba_text_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <!-- montant clé en turquoise (coût de revient dans une liste) -->
    <style name="Hesba.Text.Amount.Accent">
        <item name="android:textColor">@color/hesba_accent_text</item>
    </style>

    <!-- Badges : petit fond arrondi 8 dp -->
    <style name="Hesba.Badge" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">@font/hb_sans_semibold</item>
        <item name="fontFamily">@font/hb_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Hesba.Badge.Success">
        <item name="android:background">@drawable/bg_badge_success</item>
        <item name="android:textColor">@color/hesba_success</item>
    </style>
    <style name="Hesba.Badge.Error">
        <item name="android:background">@drawable/bg_badge_error</item>
        <item name="android:textColor">@color/hesba_error</item>
    </style>

