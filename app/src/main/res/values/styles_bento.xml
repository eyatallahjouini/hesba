<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil en grille Bento : cartes arrondies de tailles différentes, une idée par carte. -->
<resources>
    <!-- parent vide requis par aapt pour les styles Hesba.Bento.* (héritage par le nom) -->
    <style name="Hesba.Bento" />

    <!-- carte touchable : 78 dp (une rangée) ou 166 dp (deux rangées) de haut -->
    <style name="Hesba.Bento.Card">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/bento_row</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_bento_card</item>
        <item name="android:elevation">1dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">@dimen/bento_pad_small</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Hesba.Bento.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_mono_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/hb_bento_label</item>
    </style>
    <style name="Hesba.Bento.Big">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_sans_semibold</item>
        <item name="android:textSize">38sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/hb_bento_ink</item>
    </style>
    <style name="Hesba.Bento.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_sans_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/hb_bento_ink</item>
    </style>
    <style name="Hesba.Bento.Name">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/hb_bento_ink</item>
    </style>
    <style name="Hesba.Bento.Sub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hb_bento_ink_soft</item>
    </style>
    <style name="Hesba.Bento.Mono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/hb_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/hb_bento_ink_soft</item>
    </style>
    <style name="Hesba.Bento.Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/hb_bento_icon</item>
    </style>
</resources>
