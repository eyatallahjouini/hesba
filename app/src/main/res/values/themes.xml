<resources>
    <!-- Thème unique de HESBA, clair et sombre (les couleurs changent dans values-night/colors_theme.xml) -->
    <style name="Base.Theme.Hesba" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette Minimal (valeurs claires dans values/colors.xml, sombres dans values-night/colors.xml) -->
        <item name="colorPrimary">@color/hesba_primary</item>
        <item name="colorOnPrimary">@color/hesba_on_primary</item>
        <item name="colorPrimaryContainer">@color/hesba_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/hesba_text_primary</item>
        <item name="colorSecondary">@color/hesba_accent</item>
        <item name="colorOnSecondary">@color/hesba_on_accent</item>
        <item name="colorSecondaryContainer">@color/hesba_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/hesba_text_primary</item>
        <item name="colorTertiary">@color/hesba_accent_text</item>
        <item name="colorAccent">@color/hesba_accent</item>
        <!-- éléments actifs (curseur, cases, interrupteurs, sélection) en turquoise -->
        <item name="colorControlActivated">@color/hesba_accent</item>
        <item name="colorControlNormal">@color/hesba_text_secondary</item>
        <item name="colorControlHighlight">@color/hesba_ripple</item>
        <item name="colorError">@color/hesba_error</item>
        <item name="colorOnError">@color/hesba_on_primary</item>
        <item name="colorErrorContainer">@color/hesba_error_bg</item>
        <item name="colorOnErrorContainer">@color/hesba_error</item>
        <item name="android:colorBackground">@color/hesba_background</item>
        <item name="colorOnBackground">@color/hesba_text_primary</item>
        <item name="colorSurface">@color/hesba_surface</item>
        <item name="colorOnSurface">@color/hesba_text_primary</item>
        <item name="colorSurfaceVariant">@color/hesba_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/hesba_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/hesba_surface</item>
        <item name="colorSurfaceContainer">@color/hesba_surface</item>
        <item name="colorSurfaceContainerLow">@color/hesba_surface</item>
        <item name="colorSurfaceContainerHigh">@color/hesba_surface</item>
        <item name="colorSurfaceContainerHighest">@color/hesba_surface_alt</item>
        <!-- pas de teinte Material sur les surfaces surélevées (barre du bas, dialogues) -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOutline">@color/hesba_border</item>
        <item name="colorOutlineVariant">@color/hesba_border</item>
        <item name="android:windowBackground">@color/hesba_background</item>
        <item name="android:textColorPrimary">@color/hesba_text_primary</item>
        <item name="android:textColorSecondary">@color/hesba_text_secondary</item>
        <item name="android:textColorHint">@color/hesba_text_hint</item>
        <item name="android:textColorHighlight">@color/hesba_accent_soft</item>
        <!-- barre de statut ardoise, icônes blanches (BaseActivity peint la bande sous la barre : bord à bord) -->
        <item name="android:statusBarColor">@color/hesba_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Police Cairo partout : hb_sans* pointent vers Cairo (res/font) et sont appliquées
             par textViewStyle, editTextStyle et toutes les textAppearance ci-dessous -->
        <!-- police par défaut et échelle typographique Material → styles Hesba -->
        <!-- police par défaut via le style des TextView (pas via android:fontFamily du thème,
             qui passerait devant la police des textAppearance, ex. les montants en police ticket) -->
        <item name="android:textViewStyle">@style/Widget.Hesba.TextView</item>
        <item name="editTextStyle">@style/Widget.Hesba.EditTextBase</item>
        <item name="android:editTextStyle">@style/Widget.Hesba.EditTextBase</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Hesba.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Hesba.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Hesba.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Hesba.Subtitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Hesba.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Hesba.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Hesba.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Hesba.Label</item>
        <item name="materialButtonStyle">@style/Widget.Hesba.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Hesba.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Hesba.Button.Text</item>
        <item name="textInputStyle">@style/Widget.Hesba.TextInput</item>
        <item name="chipStyle">@style/Widget.Hesba.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hesba.Dialog</item>
        <item name="checkboxStyle">@style/Widget.Hesba.CheckBox</item>
        <item name="snackbarStyle">@style/Widget.Hesba.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Hesba.SnackbarText</item>
        <item name="snackbarButtonStyle">@style/Widget.Hesba.SnackbarButton</item>
    </style>

    <style name="Theme.Hesba" parent="Base.Theme.Hesba" />
</resources>
