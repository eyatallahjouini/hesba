<?xml version="1.0" encoding="utf-8"?>
<!-- Typographie : serif pour les titres (identité « carnet de comptes »), sans-serif pour le reste,
     chiffres tabulaires (tnum) pour que les montants s'alignent colonne par colonne. -->
<resources>
    <style name="TextAppearance.Hesba.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Hesba.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/hb_ink</item>
    </style>
    <style name="TextAppearance.Hesba.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/hb_ink</item>
    </style>
    <style name="TextAppearance.Hesba.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/hb_accent_ink</item>
    </style>
    <style name="TextAppearance.Hesba.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="TextAppearance.Hesba.Body.Soft">
        <item name="android:textColor">@color/hb_ink_soft</item>
    </style>
    <style name="TextAppearance.Hesba.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/hb_ink</item>
    </style>
    <style name="TextAppearance.Hesba.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/hb_ink_soft</item>
    </style>
    <style name="TextAppearance.Hesba.Money" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Hesba.Money.Small">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Hesba.Money.Large">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Hesba.Figure">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/hb_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Hesba.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
