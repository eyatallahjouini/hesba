<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : les images de factures et le modèle OCR ne partent jamais dans la sauvegarde Google.
     La base (recettes, prix) reste sauvegardée par Android si l'utilisateur l'a activé. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="factures/" />
        <exclude domain="file" path="ocr/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ocr/" />
    </device-transfer>
</data-extraction-rules>
